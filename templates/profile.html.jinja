<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Profile</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link href="/static/style.css" rel="stylesheet" />
  <link rel="icon" href="/static/products/Blueprint Logo.png" />

  <!-- CSRF TOKEN -->
  <meta name="csrf-token" content="{{ csrf_token() }}">

  <!-- Cropper -->
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css">

  <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>

  <style>

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .toast {
      animation: fadeIn 0.3s ease forwards;
    }

    .glass {
      backdrop-filter: blur(10px);
      background: rgba(11, 44, 77, 0.6);
    }

    .soft-glow {
      box-shadow: 0 0 25px rgba(111, 183, 255, 0.12);
    }

    .avatar {
      width: 95px;
      height: 95px;
      border-radius: 50%;
      overflow: hidden;
      background: #6fb7ff;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      cursor: pointer;
      font-size: 2rem;
      font-weight: bold;
      color: #0b2c4d;
    }

    .avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .avatar-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.45);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      opacity: 0;
      transition: 0.2s;
      font-size: 0.9rem;
    }

    .avatar:hover .avatar-overlay {
      opacity: 1;
    }

  </style>

</head>

<body class="min-h-screen flex flex-col bg-[#0b2c4d] text-[#d6ecff]">

{% include "components/navbar.html.jinja" %}

<!-- FLASH CONTAINER -->
<div id="flash-container"
     class="fixed top-5 right-5 z-[9999] space-y-3">
</div>

<main class="flex-grow px-6 lg:px-20 py-10">

  <!-- HEADER -->
  <div class="text-center mb-10">

    <div class="flex justify-center mb-4">

      <div class="avatar" onclick="openUploadModal()">

        {% if user['profile_pic'] %}
          <img src="{{ user['profile_pic'] }}?t={{ user['id'] }}" id="avatarImg">
          <span id="avatarText" class="hidden">{{ user['name'][0]|upper }}</span>
        {% else %}
          <span id="avatarText">{{ user['name'][0]|upper }}</span>
        {% endif %}

        <div class="avatar-overlay">Change</div>

      </div>

    </div>

    <h1 class="text-4xl font-bold">Hey {{ user['name'] }}!</h1>
    <p class="text-gray-300">Manage your account</p>

  </div>

  <!-- GRID -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- ACCOUNT -->
    <div class="glass p-6 rounded-xl border border-[#6fb7ff]/30 soft-glow">

      <h2 class="text-xl mb-4">Account Info</h2>

      <div class="space-y-3">

        <div class="p-3 bg-[#0b2c4d] rounded">
          Name: {{ user['name'] }}
        </div>

        <div class="p-3 bg-[#0b2c4d] rounded">
          Email: {{ user['email'] }}
        </div>

        <div class="bg-[#0b2c4d] p-3 rounded border-2 border-white/30">
                    <h1 class="text-3xl font-bold mb-2">👋 {{ current_user.name }}</h1>
            <div class="flex gap-6 mt-4">
                <div class="bg-white/20 rounded-lg p-4 flex-1">
                  <div class="text-sm opacity-80">Level</div>
                  <div class="text-3xl font-bold">⭐ <p class="text-white">{{ user['level'] }}</p></div>
                </div>
                <div class="bg-white/20 rounded-lg p-4 flex-1">
                  <div class="text-sm opacity-80">Points</div>
                  <div class="text-3xl font-bold">💎 <p>{{ user['points'] }}</p></div>
                </div>
                <div class="bg-white/20 rounded-lg p-4 flex-1">
                  <div class="text-sm opacity-80">Repairs Done</div>
                  <div class="text-3xl font-bold">🔧 <p>{{ user['repairs_completed'] }}</p></div>
                </div>
            </div>
        </div>

      </div>

    </div>

    <!-- ACTIONS -->
    <div class="lg:col-span-2 glass p-6 rounded-xl border border-[#6fb7ff]/30 soft-glow">

      <h2 class="text-xl mb-4">Actions</h2>

      <div class="grid grid-cols-2 gap-4">

        <a href="/edit_profile"
           class="p-5 bg-[#6fb7ff] text-[#0b2c4d] font-bold rounded text-center group-hover:scale-110 transition-transform duration-300">
          Edit Profile
        </a>

        <a href="/orders"
           class="p-5 bg-[#0b2c4d] border border-[#6fb7ff]/30 rounded text-center group-hover:scale-110 transition-transform duration-300">
          Orders
        </a>

        <button onclick="openDeleteModal()"
                class="p-5 bg-[#0b2c4d] border border-red-500 text-red-400 rounded group-hover:scale-110 transition-transform duration-300">
          Delete Account
        </button>

        <a href="/browse"
           class="p-5 bg-[#0b2c4d] border border-[#6fb7ff]/30 rounded text-center group-hover:scale-110 transition-transform duration-300">
          Shop
        </a>
         <a href="/leaderboard" class="bg-[#0b2c4d] border border-[#6fb7ff]/30 p-5 rounded-xl text-center group-hover:scale-110 transition-transform duration-300">
            🏆 View Leaderboard
        </a>

      </div>

    </div>


        <!-- Progress to next badge -->
        {% if next_badge %}
        <div class="lg:col-span-3 glass p-8 rounded-xl border border-[#6fb7ff]/30 soft-glow bg-gradient-to-r from-[#163d63] to-[#0a2540]">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h2 class="text-3xl font-bold mb-2">🎯 Next Badge</h2>
                    <p class="text-[#6fb7ff] text-lg">{{ next_badge['icon'] }} {{ next_badge['name'] }}</p>
                </div>
                <div class="text-6xl opacity-40">{{ next_badge['icon'] }}</div>
            </div>
            
            <p class="text-gray-300 mb-4">{{ next_badge['description'] }}</p>
            
            <div class="space-y-2">
                <div class="flex justify-between text-sm mb-2">
                    <span class="text-gray-400">Progress</span>
                    <span class="font-bold text-[#6fb7ff]">{{ user['repairs_completed'] }} / {{ next_badge['requirement'] }} repairs</span>
                </div>
                <div class="w-full bg-[#0a1929] rounded-full h-3 overflow-hidden border border-[#6fb7ff]/20">
                    <div class="bg-gradient-to-r from-[#6fb7ff] to-[#4a9eff] h-3 rounded-full transition-all duration-500" style="width: {{ progress_percent }}%"></div>
                </div>
                <p class="text-xs text-gray-500 mt-1">{{ (progress_percent|int) }}% complete</p>
            </div>
        </div>
        {% endif %}

        <!-- All Badges -->
        <div class="lg:col-span-3 glass p-8 rounded-xl border border-[#6fb7ff]/30 soft-glow">
            <h2 class="text-3xl font-bold mb-8 text-center">🏅 Achievement Badges</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                {% for badge in all_badges %}
                    {% set earned = badges | selectattr('badge_name', 'equalto', badge['name']) | list %}
                    <div class="group rounded-xl p-6 text-center transition-all duration-300 {% if earned %}bg-gradient-to-br from-[#2a5a3a] to-[#1a3a2a] border-2 border-[#4ade80] shadow-lg shadow-[#4ade80]/20{% else %}bg-[#163d63] border-2 border-[#6fb7ff]/20 opacity-60 hover:opacity-75{% endif %}">
                        <div class="text-6xl mb-3 group-hover:scale-110 transition-transform duration-300">{{ badge['icon'] }}</div>
                        <div class="font-bold text-lg text-white mb-1">{{ badge['name'] }}</div>
                        <div class="text-xs text-gray-300 mb-3">{{ badge['description'] }}</div>
                        {% if earned %}
                            <div class="inline-block px-3 py-1 bg-[#4ade80]/20 text-[#4ade80] text-xs font-bold rounded-full">✅ EARNED</div>
                        {% else %}
                            <div class="inline-block px-3 py-1 bg-[#6fb7ff]/20 text-[#6fb7ff] text-xs font-bold rounded-full">🔒 Locked</div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>

  </div>

</main>

<!-- DELETE MODAL -->
<div id="deleteModal" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50">
  <div class="bg-[#0e3a63] border border-red-500/40 rounded-xl p-6 w-full max-w-md text-center">
    <h2 class="text-2xl font-bold text-red-400 mb-3">Delete Account?</h2>
    <p class="text-gray-300 mb-4">Enter your password and type DELETE to confirm.</p>
    <form method="POST" action="/delete_account" id="deleteForm" class="space-y-4">

      <input type="hidden" name="csrf_token" value="{{ csrf_token() }}" />
      <!-- Password Input -->
      <input type="password" name="password" placeholder="Enter password" required class="w-full p-2 rounded bg-[#0b2c4d] border border-white/10 text-white" />
      
      <!-- Confirmation Input -->
      <input type="text" name="confirmation" placeholder='Type "DELETE" to confirm' required class="w-full p-2 rounded bg-[#0b2c4d] border border-white/10 text-white" />

      <div class="flex gap-4 justify-center">
        <button type="button" onclick="closeDeleteModal()" class="px-4 py-2 rounded bg-gray-700 hover:bg-gray-600">Cancel</button>
        <button id="deleteBtn" type="submit" class="px-4 py-2 rounded bg-red-500 hover:bg-red-600 font-bold flex items-center gap-2">
          <span id="btnText">Delete</span>
          <svg id="spinner" class="hidden w-5 h-5 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="white" stroke-width="4"></circle>
            <path class="opacity-75" fill="white" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
          </svg>


<!-- ================= UPLOAD MODAL ================= -->
<div id="uploadModal"
     class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50">

  <div class="bg-[#0b2c4d] p-6 rounded-xl w-[90%] max-w-md">

    <h2 class="text-xl mb-4">Update Profile Picture</h2>

    <input type="file" id="fileInput" accept="image/*" class="mb-4 w-full">

    <div class="w-full h-[300px] bg-[#081f36] rounded flex items-center justify-center overflow-hidden mb-4">
      <img id="cropImage" class="hidden max-w-full max-h-full" />
    </div>

    <div class="flex justify-end gap-2">

      <button onclick="closeUploadModal()"
              class="px-4 py-2 bg-gray-600 rounded">
        Cancel
      </button>

      <button onclick="uploadCropped()"
              class="px-4 py-2 bg-[#6fb7ff] text-black font-bold rounded">
        Save
      </button>

    </div>

  </div>
</div>

 <!-- DELETE MODAL -->
<div id="deleteModal"
     class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50">

  <div class="bg-[#0b2c4d] p-6 rounded-xl w-[90%] max-w-md">

    <h2 class="text-xl font-bold mb-3">Delete Account?</h2>

    <p class="text-gray-300 mb-4">
      Enter your password to permanently delete your account.
    </p>

    <form method="POST" action="/delete_account" class="space-y-4">

      <!-- CSRF -->
      <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

      <!-- PASSWORD -->
      <input type="password"
             name="password"
             placeholder="Password"
             required
             class="w-full px-4 py-2 bg-[#081f36] border border-[#6fb7ff] rounded text-white">

      <div class="flex justify-end gap-2">

        <button type="button"
                onclick="closeDeleteModal()"
                class="px-4 py-2 bg-gray-600 rounded">
          Cancel
        </button>

        <button type="submit"
                class="px-4 py-2 bg-red-500 text-white font-bold rounded">
          Delete
        </button>

      </div>

    </form>

  </div>
</div>

<!-- ================= SCRIPT ================= -->
<script>

window.addEventListener("load", () => {

  let cropper = null;

  const csrf = document.querySelector('meta[name="csrf-token"]').getAttribute("content");
  const flashContainer = document.getElementById("flash-container");

  function showFlash(message, category="success") {

    const div = document.createElement("div");

    div.className = `toast px-5 py-3 rounded-xl shadow-lg font-bold text-sm border
      ${category === "error"
        ? "bg-red-600 text-white border-red-400"
        : "bg-[#0f5e3a] text-[#b6ffd6] border-[#2aff9a]"}`;

    div.innerText = message;

    flashContainer.appendChild(div);

    setTimeout(() => {
      div.style.opacity = "0";
      div.style.transform = "translateY(-10px)";
      setTimeout(() => div.remove(), 300);
    }, 3000);
  }

  /* FLASH FROM FLASK */
  {% with messages = get_flashed_messages(with_categories=true) %}
    {% for category, message in messages %}
      showFlash({{ message|tojson }}, "{{ category }}");
    {% endfor %}
  {% endwith %}

  /* ================= UPLOAD ================= */ 

  window.openUploadModal = () =>
    document.getElementById("uploadModal").classList.remove("hidden");

  window.closeUploadModal = () => {
    document.getElementById("uploadModal").classList.add("hidden");
    if (cropper) cropper.destroy();
    cropper = null;
    document.getElementById("fileInput").value = "";
  };

  document.getElementById("fileInput").addEventListener("change", (e) => {

    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();

    reader.onload = (event) => {

      const img = document.getElementById("cropImage");
      img.src = event.target.result;
      img.classList.remove("hidden");

      if (cropper) cropper.destroy();

      cropper = new Cropper(img, {
        aspectRatio: 1,
        viewMode: 1
      });

    };

    reader.readAsDataURL(file);
  });

  window.uploadCropped = () => {

    const canvas = cropper.getCroppedCanvas({ width: 300, height: 300 });
    const image = canvas.toDataURL("image/jpeg", 0.9);

    fetch("/upload_profile_pic", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRFToken": csrf
      },
      body: JSON.stringify({ image })
    })

    .then(r => r.json())
    .then(data => {
      if (data.success) {
        showFlash("Profile updated!");

        document.getElementById("avatarImg").src =
          data.url + "?t=" + Date.now();

        closeUploadModal();
      } else {
        showFlash(data.error, "error");
      }
    });

  };

  /* ================= DELETE ================= */

  window.openDeleteModal = () =>
    document.getElementById("deleteModal").classList.remove("hidden");

  window.closeDeleteModal = () =>
    document.getElementById("deleteModal").classList.add("hidden");

  window.confirmDelete = () => {

    fetch("/delete_account", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRFToken": csrf
      }
    })

    .then(r => r.json())
    .then(data => {

      if (data.success) {
        window.location.href = "/logout";
      } else {
        showFlash("Delete failed", "error");
      }

    });

  };

});

</script>

{% include "components/footer.html.jinja" %}

</body>
</html>