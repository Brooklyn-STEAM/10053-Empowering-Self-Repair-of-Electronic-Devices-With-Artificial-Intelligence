<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Control Center</title>

    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen flex flex-col bg-[#0b2c4d] text-[#d6ecff] font-[Inter]">

{% include "components/navbar.html.jinja" %}

<div class="flex-1 flex items-center justify-center p-6">

    <div class="w-full max-w-5xl grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- PROFILE CARD -->
        <div class="bg-gray-900 rounded-2xl shadow-2xl p-6 md:col-span-1">

            <h2 class="text-2xl font-bold text-blue-300 mb-4">Profile</h2>

            <div class="space-y-3 text-sm">

                <div class="bg-black p-3 rounded">
                    <p class="text-gray-400">Name</p>
                    <p class="font-semibold">{{ User.Name }}</p>
                </div>

                <div class="bg-black p-3 rounded">
                    <p class="text-gray-400">Email</p>
                    <p class="font-semibold">{{ User.Email }}</p>
                </div>

                <div class="bg-black p-3 rounded">
                    <p class="text-gray-400">Address</p>
                    <p class="font-semibold">{{ User.Address }}</p>
                </div>

            </div>

        </div>

        <!-- ACTION CENTER -->
        <div class="bg-gray-900 rounded-2xl shadow-2xl p-6 md:col-span-2">

            <h2 class="text-2xl font-bold text-blue-300 mb-6">Control Center</h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                <!-- EDIT PROFILE -->
                <a href="/edit_profile"
                   class="bg-black hover:bg-blue-600 transition p-5 rounded-xl border border-gray-700 hover:border-blue-400">
                    <h3 class="font-bold text-lg">Edit Profile</h3>
                    <p class="text-sm text-gray-400">Update your name, email, or address</p>
                </a>

                <!-- SECURITY -->
                <div class="bg-black p-5 rounded-xl border border-gray-700 opacity-70">
                    <h3 class="font-bold text-lg">Security</h3>
                    <p class="text-sm text-gray-400">Password & login settings</p>
                </div>

                <!-- ORDER HISTORY (placeholder) -->
                <div class="bg-black p-5 rounded-xl border border-gray-700 opacity-70">
                    <h3 class="font-bold text-lg">Activity</h3>
                    <p class="text-sm text-gray-400">View recent actions</p>
                </div>

                <!-- SETTINGS -->
                <div class="bg-black p-5 rounded-xl border border-gray-700 opacity-70">
                    <h3 class="font-bold text-lg">Settings</h3>
                    <p class="text-sm text-gray-400">Customize your experience</p>
                </div>

            </div>

        </div>

    </div>

</div>

{% include "components/footer.html.jinja" %}

</body>
</html>