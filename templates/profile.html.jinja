<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">
</head>

<body class="min-h-screen flex flex-col bg-[#0b2c4d] text-[#d6ecff] leading-relaxed tracking-wide font-[Inter]">
    {% include "components/navbar.html.jinja" %}

    <main class="flex-grow">

        <!-- Header -->
        <header class="py-[70px] px-[20px] lg:px-[80px] bg-[#0e3a63] border-b-2 border-dashed border-[#6fb7ff] text-center">
            <h1 class="text-4xl mb-6 border-b-2 border-dashed border-[#6fb7ff] inline-block pb-[10px]">
                Hey {{ current_user.name }}!
            </h1>
            <p class="max-w-[700px] mx-auto text-lg leading-relaxed">
                View and manage your account details, orders, and settings.
            </p>
        </header>

        <!-- Content -->
        <div class="py-12 px-4 lg:py-[70px] lg:px-[80px] grid grid-cols-1 lg:grid-cols-3 gap-8">

            <!-- LEFT: Profile Card -->
            <div class="bg-[#0e3a63] p-6 rounded-xl shadow-lg border border-[#6fb7ff]">

                <h2 class="text-2xl mb-4 border-b border-[#6fb7ff] pb-2">
                    Account Details
                </h2>

                <div class="space-y-4">

                    <div>
                        <p class="text-sm text-gray-300">Name</p>
                        <p class="text-lg font-semibold">{{ current_user.name }}</p>
                    </div>

                    <div>
                        <p class="text-sm text-gray-300">Email</p>
                        <p class="text-lg font-semibold">{{ current_user.email }}</p>
                    </div>

                

                </div>

                <!-- Actions -->
                <div class="mt-6 space-y-3">
                    <a href="/edit_profile"
                       class="block text-center bg-[#6fb7ff] text-[#0b2c4d] py-2 rounded font-semibold hover:bg-blue-700 hover:text-white transition">
                        Edit Profile
                    </a>

                    <a href="/logout"
                       class="block text-center bg-red-500 text-white py-2 rounded font-semibold hover:bg-red-700 transition">
                        Logout
                    </a>
                </div>

            </div>

            <!-- Orders -->
            <div class="lg:col-span-2 space-y-8">

                <div class="bg-[#0e3a63] p-6 rounded-xl shadow-lg border border-[#6fb7ff]">
                    <h2 class="text-2xl mb-4 border-b border-[#6fb7ff] pb-2">
                         Orders progress
                    </h2>
                    <p class="text-gray-300">You have no orders yet.</p>
                



    </main>

</body>
</html>