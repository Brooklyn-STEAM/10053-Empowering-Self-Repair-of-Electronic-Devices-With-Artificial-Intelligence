<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png">

    <style>
        .glass {
            backdrop-filter: blur(10px);
            background: rgba(11, 44, 77, 0.7);
        }

        .soft-glow {
            box-shadow: 0 0 35px rgba(111, 183, 255, 0.18);
        }

        .hover-lift {
            transition: 0.25s ease;
        }

        .hover-lift:hover {
            transform: translateY(-4px);
        }

        .avatar {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: #6fb7ff;
            color: #0b2c4d;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 22px;
        }

        .toast {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #0e3a63;
            border: 1px solid #6fb7ff;
            padding: 12px 16px;
            border-radius: 12px;
            display: none;
        }
    </style>
</head>

<body class="min-h-screen flex flex-col bg-[#0b2c4d] text-[#d6ecff] font-[Inter]">

{% include "components/navbar.html.jinja" %}

<main class="flex-grow px-6 lg:px-20 py-10">

    <!-- HEADER -->
    <div class="text-center mb-10">

        <div class="flex justify-center mb-4">
            <div class="avatar">
                {{ current_user.name[0]|upper }}
            </div>
        </div>

        <h1 class="text-4xl font-bold border-b border-dashed border-[#6fb7ff] inline-block pb-2">
            Hey {{ current_user.name }}!
        </h1>

        <p class="text-gray-300 mt-3">
            Manage your account and activity
        </p>

    </div>

    <!-- GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- LEFT CARD -->
        <div class="glass p-6 rounded-xl border border-[#6fb7ff] soft-glow">

            <h2 class="text-xl mb-4 border-b border-[#6fb7ff] pb-2">
                Account Info
            </h2>

            <div class="space-y-4">

                <div class="bg-[#0b2c4d] p-3 rounded border border-white/5">
                    <p class="text-xs text-gray-400">Name</p>
                    <p class="font-semibold">{{ current_user.name }}</p>
                </div>

                <div class="bg-[#0b2c4d] p-3 rounded border border-white/5">
                    <p class="text-xs text-gray-400">Email</p>
                    <p class="font-semibold">{{ current_user.email }}</p>
                </div>

                <div class="bg-[#0b2c4d] p-3 rounded border border-white/5">
                    <p class="text-xs text-gray-400">Status</p>
                    <p class="font-semibold text-green-400">Active</p>
                </div>

            </div>

        </div>

        <!-- RIGHT CARD -->
        <div class="lg:col-span-2 glass p-6 rounded-xl border border-[#6fb7ff] soft-glow">

            <h2 class="text-xl mb-4 border-b border-[#6fb7ff] pb-2">
                Actions
            </h2>

            <div class="grid grid-cols-2 gap-4">

                <a href="/edit_profile"
                   onclick="showToast()"
                   class="bg-[#6fb7ff] text-[#0b2c4d] p-5 rounded-xl font-bold text-center hover-lift">
                    ⚙️ Edit Profile
                </a>

                <a href="/orders"
                   class="bg-[#0b2c4d] border border-[#6fb7ff] p-5 rounded-xl text-center hover-lift">
                    📦 My Orders
                </a>

                <a href="/browse"
                   class="bg-[#0b2c4d] border border-[#6fb7ff] p-5 rounded-xl text-center hover-lift">
                    🛒 Shop
                </a>

            </div>

        </div>

    </div>

</main>

<!-- TOAST -->
<div id="toast" class="toast">
    Opening Edit Profile...
</div>

<script>
function showToast() {
    const toast = document.getElementById("toast");
    toast.style.display = "block";

    setTimeout(() => {
        toast.style.display = "none";
    }, 2500);
}
</script>

{% include "components/footer.html.jinja" %}

</body>
</html>