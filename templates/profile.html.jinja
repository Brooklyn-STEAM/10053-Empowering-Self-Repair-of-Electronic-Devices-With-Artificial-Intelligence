<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Profile</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link href="/static/style.css" rel="stylesheet" />
  <link rel="icon" href="/static/products/Blueprint Logo.png" />

  <!-- Cropper -->
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css">

  <script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>

  <style>

    .glass {
      backdrop-filter: blur(10px);
      background: rgba(11, 44, 77, 0.6);
    }

    .soft-glow {
      box-shadow: 0 0 25px rgba(111, 183, 255, 0.12);
    }

    .avatar {
      width: 95px;
      height: 95px;
      border-radius: 50%;
      overflow: hidden;
      background: #6fb7ff;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      cursor: pointer;
      font-size: 2rem;
      font-weight: bold;
      color: #0b2c4d;
    }

    .avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .avatar-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.45);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      opacity: 0;
      transition: 0.2s;
      font-size: 0.9rem;
    }

    .avatar:hover .avatar-overlay {
      opacity: 1;
    }

    #cropImage {
      max-height: 350px;
      width: 100%;
      object-fit: contain;
    }

  </style>

</head>

<body class="min-h-screen flex flex-col bg-[#0b2c4d] text-[#d6ecff]">

{% include "components/navbar.html.jinja" %}

<main class="flex-grow px-6 lg:px-20 py-10">

  <!-- HEADER -->
  <div class="text-center mb-10">

    <div class="flex justify-center mb-4">

      <div class="avatar" onclick="openUploadModal()">

        {% if current_user.profile_pic %}

          <img
            src="{{ current_user.profile_pic }}"
            id="avatarImg"
          >

          <span id="avatarText" class="hidden">
            {{ current_user.name[0]|upper }}
          </span>

        {% else %}

          <span id="avatarText">
            {{ current_user.name[0]|upper }}
          </span>

          <img
            id="avatarImg"
            class="hidden"
          >

        {% endif %}

        <div class="avatar-overlay">
          Change
        </div>

      </div>

    </div>

    <h1 class="text-4xl font-bold">
      Hey {{ current_user.name }}!
    </h1>

    <p class="text-gray-300">
      Manage your account
    </p>

  </div>

  <!-- GRID -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- ACCOUNT INFO -->
    <div class="glass p-6 rounded-xl border border-[#6fb7ff]/30 soft-glow">

      <h2 class="text-xl mb-4">
        Account Info
      </h2>

      <div class="space-y-3">

        <div class="p-3 bg-[#0b2c4d] rounded">
          Name: {{ current_user.name }}
        </div>

        <div class="p-3 bg-[#0b2c4d] rounded">
          Email: {{ current_user.email }}
        </div>

        <div class="p-3 bg-[#0b2c4d] rounded text-green-400">
          Active
        </div>

      </div>

    </div>

    <!-- ACTIONS -->
    <div class="lg:col-span-2 glass p-6 rounded-xl border border-[#6fb7ff]/30 soft-glow">

      <h2 class="text-xl mb-4">
        Actions
      </h2>

  <div class="grid grid-cols-2 gap-4">

  <a href="/edit_profile"
     class="p-5 bg-[#6fb7ff] text-[#0b2c4d] font-bold rounded text-center">

    ✏️ Edit Profile

  </a>


        <a href="/orders"
           class="p-5 bg-[#0b2c4d] border border-[#6fb7ff]/30 rounded text-center">

          📦 Orders

        </a>

        <button onclick="openDeleteModal()"
                class="p-5 bg-[#0b2c4d] border border-red-500 text-red-400 rounded">

          🗑 Delete

        </button>

        <a href="/browse"
           class="p-5 bg-[#0b2c4d] border border-[#6fb7ff]/30 rounded text-center">

          🛒 Shop

        </a>

      </div>

    </div>

  </div>

</main>

<!-- DELETE MODAL -->
<div id="deleteModal"
     class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50">

  <div class="bg-[#0e3a63] p-6 rounded-xl w-full max-w-md">

    <h2 class="text-red-400 text-xl mb-3">
      Delete Account?
    </h2>

    <form method="POST" action="/delete_account">

      <input
        type="password"
        name="password"
        placeholder="Password"
        required
        class="w-full p-2 mb-3 rounded bg-[#0b2c4d]"
      >

      <input
        type="text"
        name="confirmation"
        placeholder="Type DELETE"
        required
        class="w-full p-2 mb-4 rounded bg-[#0b2c4d]"
      >

      <div class="flex justify-between">

        <button
          type="button"
          onclick="closeDeleteModal()"
          class="px-4 py-2 bg-gray-600 rounded"
        >
          Cancel
        </button>

        <button
          type="submit"
          class="px-4 py-2 bg-red-500 rounded"
        >
          Confirm
        </button>

      </div>

    </form>

  </div>

</div>

<!-- UPLOAD MODAL -->
<div id="uploadModal"
     class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50 px-4">

  <div class="bg-[#0e3a63] p-4 rounded-xl w-full max-w-lg border border-[#6fb7ff]/20">

    <!-- TITLE -->
    <div class="flex items-center justify-between mb-4">

      <h2 class="text-lg font-semibold">
        Upload Profile Picture
      </h2>

      <button
        onclick="closeUploadModal()"
        class="text-gray-300 hover:text-white text-xl"
      >
        ×
      </button>

    </div>

    <!-- FILE INPUT -->
    <label
      for="fileInput"
      class="flex items-center justify-center w-full h-28 border-2 border-dashed border-[#6fb7ff]/30 rounded-lg cursor-pointer bg-[#0b2c4d] hover:bg-[#12385e] transition text-sm text-gray-300"
    >

      Select an Image

    </label>

    <input
      type="file"
      id="fileInput"
      accept="image/*"
      class="hidden"
    >

    <!-- IMAGE CONTAINER -->
    <div
      id="cropContainer"
      class="hidden mt-4 bg-[#0b2c4d] rounded-lg p-3"
    >

      <div class="w-full flex justify-center">

        <img
          id="cropImage"
          class="rounded"
        >

      </div>

    </div>

    <!-- BUTTONS -->
    <div class="flex justify-end gap-3 mt-4">

      <button
        onclick="closeUploadModal()"
        class="px-4 py-2 rounded-lg bg-gray-600 text-sm"
      >
        Cancel
      </button>

      <button
        onclick="uploadCropped()"
        class="px-4 py-2 rounded-lg bg-[#6fb7ff] text-[#0b2c4d] font-semibold text-sm"
      >
        Save
      </button>

    </div>

  </div>

</div>

<script>

  let cropper = null;

  // OPEN MODAL
  function openUploadModal() {

    document.getElementById("uploadModal")
      .classList.remove("hidden");

  }

  // CLOSE MODAL
  function closeUploadModal() {

    document.getElementById("uploadModal")
      .classList.add("hidden");

    if (cropper) {
      cropper.destroy();
      cropper = null;
    }

    document.getElementById("cropImage")
      .classList.add("hidden");

    document.getElementById("cropContainer")
      .classList.add("hidden");

    document.getElementById("fileInput").value = "";

  }

  // DELETE MODAL
  function openDeleteModal() {

    document.getElementById("deleteModal")
      .classList.remove("hidden");

  }

  function closeDeleteModal() {

    document.getElementById("deleteModal")
      .classList.add("hidden");

  }

  // FILE INPUT
  document.getElementById("fileInput")
    .addEventListener("change", function (e) {

      const file = e.target.files[0];

      if (!file) return;

      // VALIDATE TYPE
      if (!file.type.startsWith("image/")) {

        alert("Please upload an image.");
        return;

      }

      // VALIDATE SIZE
      if (file.size > 5 * 1024 * 1024) {

        alert("Image too large. Max 5MB.");
        return;

      }

      const reader = new FileReader();

      reader.onload = function (event) {

        const image =
          document.getElementById("cropImage");

        const cropContainer =
          document.getElementById("cropContainer");

        image.src = event.target.result;

        image.classList.remove("hidden");

        cropContainer.classList.remove("hidden");

        if (cropper) {
          cropper.destroy();
        }

        cropper = new Cropper(image, {
          aspectRatio: 1,
          viewMode: 1,
          autoCropArea: 1,
          responsive: true,
          guides: false,
          background: false
        });

      };

      reader.readAsDataURL(file);

    });

  // UPLOAD IMAGE
  function uploadCropped() {

    if (!cropper) {

      alert("Please select an image.");
      return;

    }

    const canvas = cropper.getCroppedCanvas({
      width: 300,
      height: 300
    });

    const imageData = canvas.toDataURL("image/jpeg", 0.9);

    fetch("/upload_profile_pic", {

      method: "POST",

      headers: {
        "Content-Type": "application/json"
      },

      body: JSON.stringify({
        image: imageData
      })

    })

    .then(response => response.json())

    .then(data => {

      console.log(data);

      if (data.success) {

        const avatarImg =
          document.getElementById("avatarImg");

        const avatarText =
          document.getElementById("avatarText");

        avatarImg.src =
          data.url + "?t=" + new Date().getTime();

        avatarImg.classList.remove("hidden");

        if (avatarText) {
          avatarText.classList.add("hidden");
        }

        closeUploadModal();

      } else {

        alert("Upload failed: " + data.error);

      }

    })

    .catch(error => {

      console.error(error);

      alert("Server error during upload.");

    });

  }

  // ESC CLOSE
  document.addEventListener("keydown", function(e) {

    if (e.key === "Escape") {

      closeUploadModal();
      closeDeleteModal();

    }

  });

</script>

{% include "components/footer.html.jinja" %}

</body>
</html>