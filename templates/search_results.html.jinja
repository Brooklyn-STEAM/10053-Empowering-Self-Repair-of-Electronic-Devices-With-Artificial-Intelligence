<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <script src="https://cdn.tailwindcss.com"></script>
   <title>Search Results - BluePrint</title>
   <link href="/static/style.css" rel="stylesheet">
           <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">

   <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">
</head>

<body class="min-h-screen flex flex-col text-sm lg:text-xl bg-[#0f2f4f]">
   {% include "components/navbar.html.jinja" %}
   
   <main class="flex-grow bg-[#0f2f4f]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
         <!-- Title -->
         <h2 class="text-xl sm:text-2xl font-bold text-white mb-6">
            Search results for "{{ query }}"
         </h2>

         <!-- Results grid - matching iFixit style -->
         {% if results %}
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-4">
               {% for product in results %}
                  <a href="{% if product.type == 'product' %}/product/{{ product.ID }}{% else %}/repair-item/{{ product.ID }}{% endif %}" 
                     class="bg-[#1a3a5a] rounded-xl overflow-hidden hover:ring-2 hover:ring-[#6fb7ff] transition-all duration-200">
                     
                     <!-- Image container - square aspect ratio -->
                     <div class="aspect-square bg-white p-4 flex items-center justify-center">
                        <img src="{{ product['Image'] }}" 
                             alt="{{ product['Name'] }}"
                             class="max-w-full max-h-full object-contain">
                     </div>
                     
                     <!-- Text content - clean and minimal like iFixit -->
                     <div class="p-3">
                        <h3 class="text-white text-base leading-tight font-bold">
                           {{ product["Name"] }}
                        </h3>
                        {% if product.get("Variant") %}
                           <p class="text-gray-400 text-xs mt-1">
                              {{ product["Variant"] }}
                           </p>
                        {% endif %}
                           {% if product["Price"] %}
                              <p class="text-[#6fb7ff] text-sm font-semibold mt-2">
                                 ${{ product["Price"] }}
                              </p>
                           {% endif %}
                     </div>
                  </a>
               {% endfor %}
            </div>
         {% else %}
            <div class="text-center py-12">
               <p class="text-gray-300 text-lg">
                  No products found matching "{{ query }}"
               </p>
               <p class="text-gray-400 text-sm mt-2">
                  Try checking your spelling or using different keywords
               </p>
            </div>
         {% endif %}
      </div>
   </main>
   
   {% include "components/footer.html.jinja" %}
</body>
</html>