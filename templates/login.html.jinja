<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">
</head>

<body class="min-h-screen flex flex-col bg-[#0b2c4d] text-[#d6ecff] font-[Inter]">

{% include "components/navbar.html.jinja"%}

<main class="flex-grow flex items-center justify-center px-4">

    <div class="w-full max-w-md bg-[#0e3a63] border border-[#6fb7ff] rounded-xl shadow-lg p-8">

        <h2 class="text-2xl font-bold text-center mb-6">Sign In</h2>

        <!-- FLASH MESSAGES (FIXED) -->
        {% for message in get_flashed_messages() %}
            <p class="flash-msg bg-red-500 text-white text-sm p-3 rounded-lg mb-4 font-semibold">
                {{ message }}
            </p>
        {% endfor %}

        <form method="post" class="flex flex-col gap-4">

            <!-- EMAIL -->
            <div>
                <label class="block text-sm mb-1 text-gray-300">Email</label>
                <input
                    required
                    type="email"
                    name="email"
                    class="w-full px-4 py-2 rounded-lg bg-[#0b2c4d] border border-[#6fb7ff] text-white focus:outline-none focus:ring-2 focus:ring-[#6fb7ff]"
                >
            </div>

            <!-- PASSWORD -->
            <div>
                <label class="block text-sm mb-1 text-gray-300">Password</label>
                <input
                    required
                    type="password"
                    name="password"
                    class="w-full px-4 py-2 rounded-lg bg-[#0b2c4d] border border-[#6fb7ff] text-white focus:outline-none focus:ring-2 focus:ring-[#6fb7ff]"
                >
            </div>

            <!-- BUTTON -->
            <button
                type="submit"
                class="mt-2 bg-[#6fb7ff] hover:bg-[#5aa7f0] text-[#0b2c4d] font-bold py-2 rounded-lg transition"
            >
                Login
            </button>

        </form>

        <!-- SIGNUP LINK -->
        <p class="text-center text-sm mt-6 text-gray-300">
            Don’t have an account?
            <a href="/signup" class="text-[#6fb7ff] underline hover:text-[#5aa7f0]">
                Create one
            </a>
        </p>

    </div>

</main>

<!-- AUTO DISAPPEAR SCRIPT -->
<script>
document.addEventListener("DOMContentLoaded", () => {
  setTimeout(() => {
    const messages = document.querySelectorAll('.flash-msg');

    messages.forEach(msg => {
      msg.style.transition = "all 0.5s ease";
      msg.style.opacity = "0";
      msg.style.transform = "translateY(-10px)";

      setTimeout(() => {
        msg.remove();
      }, 500);
    });

  }, 3000);
});
</script>

</body>
</html>