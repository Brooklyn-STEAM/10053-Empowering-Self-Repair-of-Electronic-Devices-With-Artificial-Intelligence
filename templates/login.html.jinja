<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">

    <style>

        @keyframes fadeIn {

            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .toast {
            animation: fadeIn 0.3s ease forwards;
        }

    </style>

</head>

<body class="min-h-screen flex flex-col bg-[#0b2c4d] text-[#d6ecff] font-[Inter]">

{% include "components/navbar.html.jinja" %}

<!-- FLASH CONTAINER -->
<div id="flash-container"
     class="fixed top-5 right-5 z-[9999] space-y-3">
</div>

<main class="flex-grow flex items-center justify-center px-4">

    <div class="w-full
                max-w-md
                bg-[#0e3a63]
                border border-[#6fb7ff]
                rounded-xl
                shadow-lg
                p-8">

        <!-- TITLE -->
        <h2 class="text-2xl font-bold text-center mb-6">

            Sign In

        </h2>

        <!-- FORM -->
        <form method="POST"
              class="flex flex-col gap-4">

            <!-- CSRF -->
            <input type="hidden"
                   name="csrf_token"
                   value="{{ csrf_token() }}">

            <!-- EMAIL -->
            <div>

                <label class="block text-sm mb-1 text-gray-300">

                    Email

                </label>

                <input
                    required
                    type="email"
                    name="email"

                    class="w-full
                           px-4 py-2
                           rounded-lg
                           bg-[#0b2c4d]
                           border border-[#6fb7ff]
                           text-white
                           focus:outline-none
                           focus:ring-2
                           focus:ring-[#6fb7ff]"
                >

            </div>

            <!-- PASSWORD -->
            <div>

                <label class="block text-sm mb-1 text-gray-300">

                    Password

                </label>

                <input
                    required
                    type="password"
                    name="password"

                    class="w-full
                           px-4 py-2
                           rounded-lg
                           bg-[#0b2c4d]
                           border border-[#6fb7ff]
                           text-white
                           focus:outline-none
                           focus:ring-2
                           focus:ring-[#6fb7ff]"
                >

            </div>

            <!-- BUTTON -->
            <button
                type="submit"

                class="mt-2
                       bg-[#6fb7ff]
                       hover:bg-[#5aa7f0]
                       text-[#0b2c4d]
                       font-bold
                       py-2
                       rounded-lg
                       transition">

                Login

            </button>

        </form>

        <!-- LINKS -->
        <p class="text-center text-sm mt-6 text-gray-300">

            Don’t have an account?

            <a href="/signup"
               class="text-[#6fb7ff]
                      underline
                      hover:text-[#5aa7f0]">

                Create one

            </a>

            <br><br>

            <a href="/forgot_password"
               class="text-[#6fb7ff]
                      underline
                      hover:text-[#5aa7f0]">

                Forgot Password?

            </a>

        </p>

    </div>

</main>

<!-- FLASH SCRIPT -->
<script>

document.addEventListener("DOMContentLoaded", () => {

    const flashContainer =
        document.getElementById("flash-container");

    /* =========================
       SHOW FLASH
    ========================= */

    function showFlash(message, category = "success") {

        const div =
            document.createElement("div");

        div.className = `
            toast px-5 py-3 rounded-xl shadow-lg
            font-bold text-sm border transition duration-300

            ${category === "error"
                ? "bg-red-600 text-white border-red-400"
                : "bg-[#0f5e3a] text-[#b6ffd6] border-[#2aff9a]"
            }
        `;

        div.innerText = message;

        flashContainer.appendChild(div);

        setTimeout(() => {

            div.style.opacity = "0";
            div.style.transform =
                "translateY(-10px)";

            setTimeout(() => {

                div.remove();

            }, 300);

        }, 3000);
    }

    /* =========================
       LOAD FLASK FLASHES
    ========================= */

    {% with messages = get_flashed_messages(with_categories=true) %}
      {% if messages %}

        {% for category, message in messages %}

            showFlash(
                {{ message|tojson }},
                "{{ category }}"
            );

        {% endfor %}

      {% endif %}
    {% endwith %}

});

</script>

</body>
</html>