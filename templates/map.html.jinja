<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <style>
        body {
            display: flex;
            flex-direction: column;
            margin: 0;
            padding: 0;
            height: 100vh;
        }
       .navbar {
    position: relative; 
    z-index: 10;

                }

    /* Adjust the map to avoid overlapping */
        #map {
    margin-top: 40px; /* Adjust this value based on the navbar height */
    height: calc(100vh - 60px); /* Full height minus the navbar height */
    width: 100%;
                }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Repair Map</title>
    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">
</head>

<body class="bg-[#0b2c4d] text-[#d6ecff] font-mono min-h-screen flex flex-col text-sm lg:text-lg">
    <div class="navbar">
        {% include "components/navbar.html.jinja" %}
    </div>
    <br>
    <h1 class="text-3xl md:text-4xl mb-4 border-b-2 border-dashed border-[#6fb7ff] inline-block pb-2 text-center">
        Find Repair Centers Near You 

    <div id="map"></div>

   <script>
    var map = L.map('map').setView([40.6987909591662, -73.97121363208167], 13);

    var osm = L.tileLayer('https://api.maptiler.com/maps/dataviz-v4/{z}/{x}/{y}.png?key=HWne2349v5WDLtpgx5BN', {
        maxZoom: 19,
        attribution: '<a href="https://www.maptiler.com/copyright/" target="_blank">&copy; MapTiler</a> <a href="https://www.openstreetmap.org/copyright/" target="_blank">&copy; OpenStreetMap contributors</a>'
    }).addTo(map);

    var centers = {{ centers | tojson }};
    centers.forEach(function(center) {
        console.log(center.image); // Debugging
        var imageUrl = center.image ? "/static/" + center.image : "/static/products/Blueprint Logo.png";
        L.marker([center.lat, center.lng])
            .addTo(map)
            .bindPopup(center.name + "<br>" + center.address + "<br><br>" + "<img src='" + imageUrl + "' style='width: 200px; height: 200px; object-fit: cover; display: block; margin: 0 auto;'>");
            }); 

    var circle = L.circle([40.6987909591662, -73.97121363208167], {
        color: 'blue',
        fillColor: '#6fb7ff',
        fillOpacity: 0.5,
        radius: 3250
    }).addTo(map);
</script>

    {% include "components/footer.html.jinja" %}
</body>
</html>