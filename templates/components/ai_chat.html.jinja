<!-- Markdown parser -->
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<!-- Sanitizer for safe HTML rendering -->
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.0.6/dist/purify.min.js"></script>

<!-- Floating Button (OUTSIDE chat window) -->
<button onclick="toggleChat()"
    class="fixed bottom-6 right-6 bg-blue-500 text-white px-4 py-3 rounded-full shadow-lg z-50 hover:bg-sky-700 active:bg-blue-800"
    style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px;">
    AI Help
</button>

<!-- Main content wrapper - this will be resized -->
<div id="mainContent" class="transition-all duration-300" style="margin-right: 0;">
    <!-- All your existing website content goes here -->
    <!-- This div should wrap your entire main content -->
</div>

<!-- Chat Window -->
<div id="chatWindow"
    class="hidden fixed bottom-20 right-6 w-96 bg-[#1a3a5a] rounded-xl shadow-lg flex flex-col h-[500px] z-50 transition-all duration-300"
    style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">

    <!-- Header -->
    <div class="p-3 border-b border-[#2a4a6a] text-white flex justify-between items-center"
        style="font-size: 16px; font-weight: 500;">
        <span>AI Repair Assistant</span>
        <div class="flex gap-2">
            <button onclick="toggleExpandedView()" 
                    id="expandBtn"
                    class="text-gray-300 hover:text-white text-sm px-2"
                    style="font-size: 12px;" 
                    title="Expand to split screen">📱 Split View</button>
            <button onclick="clearChat()" 
                    class="text-gray-300 hover:text-white text-sm px-2"
                    style="font-size: 12px;">🗑️ Clear</button>
            <button onclick="toggleChat()" 
                    style="font-size: 16px;">✕</button>
        </div>
    </div>

    <!-- Chat Messages -->
    <div id="chatBox" class="flex-1 overflow-y-auto p-3 space-y-2 flex flex-col">
    </div>

    <!-- Input Area -->
    <div class="p-3 border-t border-[#2a4a6a]">
        <!--<input type="file" id="imageUpload" 
            class="mb-2 text-white text-xs"
            style="font-size: 12px;">-->

        <input id="msg"
            class="w-full p-2 rounded text-black mb-2"
            placeholder="Describe your issue..."
            style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px;">

        <button id="sendBtn"
                class="bg-blue-500 px-4 py-2 rounded text-white w-full"
                style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; font-weight: 500;">
            Send
        </button>
    </div>

    <!-- Resize Handle (only visible in split view) -->
    <div id="resizeHandle" class="hidden absolute left-0 top-0 w-2 h-full cursor-ew-resize bg-transparent hover:bg-blue-400 hover:opacity-30 z-10"></div>
</div>

<script>
// Chat visibility and expansion state
let isChatVisible = false;
let isExpanded = false;
let currentChatWidth = 40; // Default split screen width percentage

// Toggle chat visibility
function toggleChat() {
    const chatWindow = document.getElementById("chatWindow");
    const mainContent = document.getElementById("mainContent");
    
    isChatVisible = !isChatVisible;
    
    if (isChatVisible) {
        chatWindow.classList.remove("hidden");
    } else {
        chatWindow.classList.add("hidden");
        // Reset main content when closing
        if (isExpanded) {
            mainContent.style.marginRight = "0";
            isExpanded = false;
        }
    }
}

// Toggle between normal and split screen view
function toggleExpandedView() {
    const chatWindow = document.getElementById("chatWindow");
    const mainContent = document.getElementById("mainContent");
    const expandBtn = document.getElementById("expandBtn");
    const resizeHandle = document.getElementById("resizeHandle");
    
    isExpanded = !isExpanded;
    
    if (isExpanded) {
        // Switch to split screen mode
        chatWindow.classList.remove("bottom-20", "right-6", "w-96", "h-[500px]", "rounded-xl");
        chatWindow.classList.add("top-0", "right-0", "h-full", "rounded-none");
        chatWindow.style.width = currentChatWidth + "%";
        
        // Resize main content to make room for chat
        mainContent.style.marginRight = currentChatWidth + "%";
        
        expandBtn.innerHTML = "📱 Window";
        expandBtn.title = "Return to window view";
        resizeHandle.classList.remove("hidden");
    } else {
        // Switch back to window mode
        chatWindow.classList.add("bottom-20", "right-6", "w-96", "h-[500px]", "rounded-xl");
        chatWindow.classList.remove("top-0", "right-0", "h-full", "rounded-none");
        chatWindow.style.width = ""; // Reset inline width
        
        // Reset main content
        mainContent.style.marginRight = "0";
        
        expandBtn.innerHTML = "📱 Split View";
        expandBtn.title = "Expand to split screen";
        resizeHandle.classList.add("hidden");
    }
}

// Resize functionality
let isResizing = false;

document.getElementById("resizeHandle").addEventListener("mousedown", (e) => {
    isResizing = true;
    document.addEventListener("mousemove", handleResize);
    document.addEventListener("mouseup", stopResize);
    e.preventDefault();
});

function handleResize(e) {
    if (!isResizing || !isExpanded) return;
    
    const chatWindow = document.getElementById("chatWindow");
    const mainContent = document.getElementById("mainContent");
    const windowWidth = window.innerWidth;
    const mouseX = e.clientX;
    
    // Calculate new width as percentage of window width
    const newWidth = ((windowWidth - mouseX) / windowWidth) * 100;
    
    // Constrain between 20% and 40% of screen width
    const constrainedWidth = Math.max(20, Math.min(40, newWidth));
    
    // Update chat window and main content
    chatWindow.style.width = constrainedWidth + "%";
    mainContent.style.marginRight = constrainedWidth + "%";
    
    // Store current width
    currentChatWidth = constrainedWidth;
}

function stopResize() {
    isResizing = false;
    
    // Restore smooth transitions after dragging stops (faster: 0.1s)
    const chatWindow = document.getElementById("chatWindow");
    const mainContent = document.getElementById("mainContent");
    chatWindow.style.transition = "width 0.1s ease, margin-right 0.1s ease";
    mainContent.style.transition = "width 0.1s ease, margin-right 0.1s ease";
    
    document.removeEventListener("mousemove", handleResize);
    document.removeEventListener("mouseup", stopResize);
}

// Handle window resize
window.addEventListener("resize", () => {
    if (isExpanded) {
        const chatWindow = document.getElementById("chatWindow");
        const mainContent = document.getElementById("mainContent");
        // Maintain current width percentage
        chatWindow.style.width = currentChatWidth + "%";
        mainContent.style.marginRight = currentChatWidth + "%";
    }
});

// Convert Markdown to safe HTML and also auto-link /guide/### URLs
function renderMarkdown(text) {
    if (!text) return "";
    // First, convert markdown -> HTML
    let html = marked.parse(text, { breaks: true, gfm: true });
    // Then auto-link guide URLs
    html = html.replace(
        /(\/guide\/\d+)/g,
        '<a href="$1" class="text-blue-600 underline" target="_blank">Open Guide</a>'
    );
    // Sanitize before injecting
    return DOMPurify.sanitize(html);
}

// Load history from server and display
async function loadChatHistory() {
    try {
        const res = await fetch('/chat-history');
        const data = await res.json();
        const history = data.history || [];
        const chatBox = document.getElementById("chatBox");
        chatBox.innerHTML = "";
        for (const msg of history) {
            const msgDiv = document.createElement("div");
            msgDiv.className = msg.role === "user"
                ? "chat-bubble user-bubble bg-blue-500 text-white p-3 rounded-lg self-end ml-auto max-w-[85%]"
                : "chat-bubble ai-bubble bg-gray-100 text-black p-3 rounded-lg self-start mr-auto max-w-[90%]";
            msgDiv.innerHTML = renderMarkdown(msg.content);
            chatBox.appendChild(msgDiv);
        }
        chatBox.scrollTop = chatBox.scrollHeight;
    } catch (err) {
        console.error("Failed to load chat history:", err);
    }
}

// Clear chat history
async function clearChat() {
    try {
        await fetch('/clear-chat', { method: 'POST' });
        document.getElementById("chatBox").innerHTML = "";
    } catch (err) {
        console.error("Failed to clear chat:", err);
    }
}

document.addEventListener("DOMContentLoaded", () => {
    const sendBtn = document.getElementById("sendBtn");
    const msgInput = document.getElementById("msg");

    sendBtn.addEventListener("click", sendMsg);
    msgInput.addEventListener("keydown", function(e) {
        if (e.key === "Enter") {
            e.preventDefault();
            sendMsg();
        }
    });

    function addMessage(text, sender) {
        const chatBox = document.getElementById("chatBox");
        const msgDiv = document.createElement("div");
        msgDiv.className = sender === "user"
            ? "chat-bubble user-bubble bg-blue-500 text-white p-3 rounded-lg self-end ml-auto max-w-[85%]"
            : "chat-bubble ai-bubble bg-gray-100 text-black p-3 rounded-lg self-start mr-auto max-w-[90%]";
        msgDiv.innerHTML = renderMarkdown(text);
        chatBox.appendChild(msgDiv);
        chatBox.scrollTop = chatBox.scrollHeight;
        return msgDiv;
    }

    // Reveal AI response with a clean fade-in (replaces typewriter effect)
    function revealMessage(element, fullText) {
        return new Promise((resolve) => {
            element.innerHTML = renderMarkdown(fullText);
            element.style.opacity = 0;
            element.style.transition = "opacity 0.4s ease";
            requestAnimationFrame(() => {
                element.style.opacity = 1;
            });
            const chatBox = document.getElementById("chatBox");
            chatBox.scrollTop = chatBox.scrollHeight;
            setTimeout(resolve, 400);
        });
    }

    async function sendMsg() {
        try {
            const fileInput = document.getElementById("imageUpload");
            const msg = msgInput.value.trim();
            const file = fileInput.files[0];

            if (!msg && !file) return;

            let guideId = null;
            const metaGuide = document.querySelector('meta[name="guide-id"]');
            if (metaGuide) guideId = metaGuide.getAttribute('content');

            if (msg) addMessage(msg, "user");
            if (file) addMessage("📷 Image uploaded", "user");

            const thinkingDiv = addMessage("_Thinking..._", "ai");

            const formData = new FormData();
            formData.append("message", msg);
            if (file) formData.append("image", file);
            if (guideId) formData.append("guide_id", guideId);

            msgInput.value = "";
            fileInput.value = "";

            const res = await fetch("/ai-help", {
                method: "POST",
                body: formData
            });

            if (!res.ok) throw new Error("Server error");

            const data = await res.json();
            thinkingDiv.remove();

            const aiMsgDiv = document.createElement("div");
            aiMsgDiv.className = "chat-bubble ai-bubble bg-gray-100 text-black p-3 rounded-lg self-start mr-auto max-w-[90%]";
            document.getElementById("chatBox").appendChild(aiMsgDiv);

            await revealMessage(aiMsgDiv, data.reply);

        } catch (err) {
            console.error(err);
            const chatBox = document.getElementById("chatBox");
            const lastChild = chatBox.lastChild;
            if (lastChild && lastChild.textContent.trim() === "Thinking...") {
                lastChild.remove();
            }
            addMessage("⚠️ Error connecting to AI", "ai");
        }
    }

    // Load chat history on page load
    loadChatHistory();
});
</script>

<style>
/* ===== Chat Bubble Typography ===== */
.chat-bubble {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 14px;
    line-height: 1.5;
    word-wrap: break-word;
}

/* Headings inside AI responses */
.ai-bubble h1,
.ai-bubble h2,
.ai-bubble h3 {
    font-weight: 600;
    margin: 10px 0 6px 0;
    color: #1a3a5a;
}
.ai-bubble h1 { font-size: 16px; }
.ai-bubble h2 { font-size: 15px; }
.ai-bubble h3 { font-size: 14px; }

/* Paragraphs */
.ai-bubble p {
    margin: 6px 0;
}

/* Bulleted & numbered lists */
.ai-bubble ul,
.ai-bubble ol {
    margin: 6px 0 8px 0;
    padding-left: 22px;
}
.ai-bubble li {
    margin-bottom: 4px;
}

/* Bold & emphasis */
.ai-bubble strong { font-weight: 600; color: #0f2d4a; }
.ai-bubble em { font-style: italic; }

/* Code / inline snippets */
.ai-bubble code {
    background: #e5e7eb;
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 13px;
    font-family: "SF Mono", Menlo, Consolas, monospace;
}
.ai-bubble pre {
    background: #1f2937;
    color: #f3f4f6;
    padding: 10px;
    border-radius: 6px;
    overflow-x: auto;
    margin: 8px 0;
    font-size: 12.5px;
}

/* Blockquotes */
.ai-bubble blockquote {
    border-left: 3px solid #3b82f6;
    padding-left: 10px;
    margin: 8px 0;
    color: #374151;
    font-style: italic;
}

/* Remove extra top/bottom space from first/last items */
.ai-bubble > *:first-child { margin-top: 0; }
.ai-bubble > *:last-child { margin-bottom: 0; }

/* Links inside AI messages */
.ai-bubble a {
    color: #2563eb;
    text-decoration: underline;
}

/* Horizontal rule */
.ai-bubble hr {
    border: none;
    border-top: 1px solid #d1d5db;
    margin: 10px 0;
}

/* Additional styles for better resize handle visibility */
#resizeHandle:hover::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translateX(-50%) translateY(-50%);
    width: 4px;
    height: 40px;
    background-color: #3b82f6;
    border-radius: 2px;
    opacity: 0.7;
}

/* Smooth transitions */
#chatWindow, #mainContent {
    transition: width 0.3s ease, margin-right 0.3s ease;
}

/* Ensure the chat window stays on top */
#chatWindow {
    z-index: 1000;
}

/* Prevent horizontal scrollbar when content is resized */
body {
    overflow-x: hidden;
}
</style>