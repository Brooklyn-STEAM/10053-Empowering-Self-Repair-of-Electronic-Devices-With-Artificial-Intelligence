<!-- Floating Button (OUTSIDE chat window) -->
<button onclick="toggleChat()"
    class="fixed bottom-6 right-6 bg-blue-500 text-white px-4 py-3 rounded-full shadow-lg z-50 hover:bg-sky-700 active:bg-blue-800">
    AI Help
</button>

<!-- Chat Window -->
<div id="chatWindow"
     class="hidden fixed bottom-20 right-6 w-96 bg-[#1a3a5a] rounded-xl shadow-lg flex flex-col h-[500px] z-50">

    <!-- Header -->
    <div class="p-3 border-b border-[#2a4a6a] text-white flex justify-between">
        AI Repair Assistant
        <button onclick="toggleChat()">✕</button>
    </div>

    <!-- Chat Messages -->
    <div id="chatBox" class="flex-1 overflow-y-auto p-3 space-y-2 text-sm flex flex-col">
    </div>

    <!-- Input Area -->
    <div class="p-3 border-t border-[#2a4a6a]">

        <input type="file" id="imageUpload" class="mb-2 text-white text-xs">

        <input id="msg"
               class="w-full p-2 rounded text-black mb-2"
               placeholder="Describe your issue...">

        <button id="sendBtn"
                class="bg-blue-500 px-4 py-2 rounded text-white w-full">
            Send
        </button>
    </div>
</div>

<script>
function toggleChat() {
    const chat = document.getElementById("chatWindow");
    chat.classList.toggle("hidden");
}

document.addEventListener("DOMContentLoaded", () => {

    const sendBtn = document.getElementById("sendBtn");
    const msgInput = document.getElementById("msg");

    sendBtn.addEventListener("click", sendMsg);

    // ENTER KEY SUPPORT
    msgInput.addEventListener("keydown", function(e) {
        if (e.key === "Enter") {
            e.preventDefault();
            sendMsg();
        }
    });

    function addMessage(text, sender) {
        const chatBox = document.getElementById("chatBox");

        const msgDiv = document.createElement("div");

        msgDiv.className =
            sender === "user"
            ? "bg-blue-500 text-white p-2 rounded-lg self-end ml-auto max-w-[75%]"
            : "bg-gray-300 text-black p-2 rounded-lg self-start mr-auto max-w-[75%]";

        // Apply link formatting immediately (for user messages or static content)
        msgDiv.innerHTML = formatLinks(text);

        chatBox.appendChild(msgDiv);
        chatBox.scrollTop = chatBox.scrollHeight;
        return msgDiv;
    }

    function formatLinks(text) {
        // Replace /guide/ID with clickable link
        return text.replace(
            /(\/guide\/\d+)/g,
            '<a href="$1" class="text-blue-600 underline" target="_blank">Open Guide</a>'
        );
    }

    // Typewriter effect
    function typeText(element, fullText, speed = 30) {
        return new Promise((resolve) => {
            let i = 0;
            element.textContent = "";  // start empty

            function typeNextChar() {
                if (i < fullText.length) {
                    element.textContent += fullText.charAt(i);
                    i++;
                    // Auto-scroll as text grows
                    const chatBox = document.getElementById("chatBox");
                    chatBox.scrollTop = chatBox.scrollHeight;
                    setTimeout(typeNextChar, speed);
                } else {
                    // When done, apply link formatting (so /guide/ID becomes clickable)
                    element.innerHTML = formatLinks(fullText);
                    resolve();
                }
            }

            typeNextChar();
        });
    }

    async function sendMsg() {
    try {
        const fileInput = document.getElementById("imageUpload");
        const msg = msgInput.value.trim();
        const file = fileInput.files[0];

        if (!msg && !file) return;

        // --- Get current guide ID from meta tag ---
        let guideId = null;
        const metaGuide = document.querySelector('meta[name="guide-id"]');
        if (metaGuide) {
            guideId = metaGuide.getAttribute('content');
        }

        if (msg) addMessage(msg, "user");
        if (file) addMessage("📷 Image uploaded", "user");

        const thinkingDiv = addMessage("Thinking...", "ai");

        const formData = new FormData();
        formData.append("message", msg);
        if (file) formData.append("image", file);
        if (guideId) formData.append("guide_id", guideId);   // <-- Send guide ID

        msgInput.value = "";
        fileInput.value = "";

        const res = await fetch("/ai-help", {
            method: "POST",
            body: formData
        });

        if (!res.ok) {
            throw new Error("Server error");
        }

        const data = await res.json();

        thinkingDiv.remove();

        const aiMsgDiv = document.createElement("div");
        aiMsgDiv.className = "bg-gray-300 text-black p-2 rounded-lg self-start mr-auto max-w-[75%]";
        document.getElementById("chatBox").appendChild(aiMsgDiv);

        await typeText(aiMsgDiv, data.reply, 10);

    } catch (err) {
        console.error(err);
        const chatBox = document.getElementById("chatBox");
        const lastChild = chatBox.lastChild;
        if (lastChild && lastChild.textContent === "Thinking...") {
            lastChild.remove();
        }
        addMessage("⚠️ Error connecting to AI", "ai");
    }
}

});
</script>