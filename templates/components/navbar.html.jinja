<nav class="bg-[#081f36] border-b border-[#6fb7ff]">
    <script>
        function toggleMenu() {
        document.getElementById("mobileMenu").classList.toggle("hidden");
        }

        function toggleSearch() {
        document.getElementById("mobileSearch").classList.toggle("hidden");
        }
    </script>
  <div class="max-w-7xl mx-auto px-4 lg:px-8">
    <div class="flex justify-between items-center h-14">


      <!-- Logo -->
      <div class="font-bold tracking-widest text-sm">
        <a href="/">
            <img src="/static/products/Blueprint Logo.png"
            alt="BluePrint Logo"
            class="h-8 w-auto">
        </a>
      </div>

    <form method="get" action="/search" class="relative text-gray-600 lg:block hidden"> 
         <input
                class="border-2 border-gray-300 bg-white h-10 w-64 pl-2 pr-8 rounded-lg text-sm focus:outline-none"
                type="search" name="q" placeholder="Search">
    </form>

      <!-- Links -->
      <div class="hidden lg:flex space-x-8 text-sm items-center">
      
        <a href="/" class="hover:text-[#6fb7ff] transition">Home</a>
        <a href="/browse" class="hover:text-[#6fb7ff] transition">Product</a>
        <a href="/cart" class="hover:text-[#6fb7ff] transition">Cart</a>
        <a href="/repairs" class="hover:text-[#6fb7ff] transition">Repairs</a>
        <a href="/about_us" class="hover:text-[#6fb7ff] transition">About Us</a>


                        {% if  not current_user.is_authenticated %}
                        <div class="">
                            <a href="/login"
                                class="bg-[#6fb7ff] text-[#0b2c4d] px-4 py-1 rounded font-semibold hover:text-white hover:bg-blue-700 transition">
                                    Login
                                </a>
                        </div>
                        {% else %}
                            <div class="flex space-x-2 items-center">
                                {% if  not current_user.is_authenticated %}
                                    <span id="greeting" class=""> Hi, {{current_user.name}} <br> </span>
                                {%endif%}
                            <div class="">
                                    <a href="/logout"
                                            class="bg-[#6fb7ff] text-[#0b2c4d] px-4 py-1 rounded font-semibold hover:text-white hover:bg-red-700  transition">
                                        Logout
                                    </a>
                            </div> 
                            </div>

                        {% endif %}
                    

        </div>

    <!-- Mobile Search -->
    <span class="pb-1 lg:hidden">
        <form class="flex-1 mx-4 lg:hidden" method="get" action="/search">
            <input class="w-full h-9 px-3 rounded-lg text-sm border-2 border-gray-300 focus:outline-none"
                type="search" placeholder="Search" name="q">
        </form>
    </span>

        <div class="flex items-center space-x-4 lg:hidden">
            <button onclick="toggleMenu()" class="text-white text-xl">
                ☰
            </button>
        
        </div>

        
    </div>

    


    

    <!-- Mobile Dropdown -->
    <div id="mobileMenu" class="hidden flex flex-col space-y-3 pb-4 lg:hidden text-sm">
      <a href="/">Home</a>
      <a href="/products">Product</a>
      <a href="/cart">Cart</a>
      <a href="/repairs">Repairs</a>
      <a href="/about_us">About Us</a>
      {% if not current_user.is_authenticated %}
        <a href="/login" class="font-bold">Login</a>
        {% else %}
            <a href="/logout">Logout</a>
       {% endif %}
    </div>
    
    </div>
  </div>
</nav>

