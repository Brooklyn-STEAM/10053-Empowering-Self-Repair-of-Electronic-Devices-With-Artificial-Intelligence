<nav class="sticky top-0 z-50 bg-[#081f36] border-b border-[#6fb7ff] text-[#d6ecff] text-base lg:text-lg font-[Inter] tracking-wide">

<div class="max-w-7xl mx-auto px-4 lg:px-8">
    <div class="flex justify-between items-center h-14">

      <!-- Logo -->
      <div class="font-bold tracking-widest text-sm">
        <a href="/">
          <img src="/static/products/Blueprint Logo.png"
               alt="BluePrint Logo"
               class="h-8 w-auto">
        </a>
      </div>

      <!-- Desktop Search -->
      <form method="get" action="/search" class="relative mx-auto text-gray-600 hidden lg:block">
        <input
          class="border-2 border-gray-300 bg-white h-10 w-64 pl-2 pr-8 rounded-lg text-sm focus:outline-none"
          type="search" name="q" placeholder="Search" required>
        <button type="submit" class="absolute right-0 top-0 mt-3 mr-2">
          <svg class="text-gray-600 h-4 w-4 fill-current" viewBox="0 0 56.966 56.966">
            <path d="M55.146,51.887L41.588,37.786c3.486-4.144,5.396-9.358,5.396-14.786
            c0-12.682-10.318-23-23-23s-23,10.318-23,23
            s10.318,23,23,23c4.761,0,9.298-1.436,13.177-4.162
            l13.661,14.208c0.571,0.593,1.339,0.92,2.162,0.92
            c0.779,0,1.518-0.297,2.079-0.837
            C56.255,54.982,56.293,53.08,55.146,51.887z
            M23.984,6c9.374,0,17,7.626,17,17
            s-7.626,17-17,17s-17-7.626-17-17
            S14.61,6,23.984,6z"/>
          </svg>
        </button>
      </form>

      <!-- Desktop Links -->
      <div class="hidden lg:flex space-x-8 text-sm items-center">

        <a href="/" class="nav-link hover:text-[#6fb7ff] transition">Home</a>
        <a href="/browse" class="nav-link hover:text-[#6fb7ff] transition">Product</a>
        <a href="/cart" class="nav-link hover:text-[#6fb7ff] transition">Cart</a>
        <a href="/repairs" class="nav-link hover:text-[#6fb7ff] transition">Repairs</a>
        <a href="/about_us" class="nav-link hover:text-[#6fb7ff] transition">About Us</a>

        <!-- Profile Dropdown -->
        <div class="relative">
          {% if current_user.is_authenticated %}
          
          <button onclick="toggleUserMenu()" 
            class="flex items-center space-x-2 bg-[#6fb7ff] text-[#0b2c4d] px-3 py-1 rounded font-semibold hover:bg-blue-700 hover:text-white transition">
            <span>{{ current_user.name }}</span>
            <span>▼</span>
          </button>

          <div id="userMenu" 
            class="hidden absolute right-0 mt-2 w-40 bg-white rounded-lg shadow-lg text-black z-50">
            <a href="/profile" class="block px-4 py-2 hover:bg-gray-100">Profile</a>
            <a href="/orders" class="block px-4 py-2 hover:bg-gray-100">Orders</a>
            <a href="/logout" class="block px-4 py-2 hover:bg-red-100 text-red-600">Logout</a>
          </div>

          {% else %}

          <button onclick="toggleUserMenu()" 
            class="bg-[#6fb7ff] text-[#0b2c4d] px-4 py-1 rounded font-semibold hover:bg-blue-700 hover:text-white transition">
            Account ▼
          </button>

          <div id="userMenu" 
            class="hidden absolute right-0 mt-2 w-40 bg-white rounded-lg shadow-lg text-black z-50">
            <a href="/login" class="block px-4 py-2 hover:bg-gray-100">Login</a>
          </div>

          {% endif %}
        </div>

      </div>

      <!-- Mobile Search -->
      <div class="lg:hidden flex-1 mx-4">
        <form method="get" action="/search">
          <input class="w-full h-9 px-3 rounded-lg text-sm border-2 border-gray-300 focus:outline-none"
                 type="search" name="q" placeholder="Search" required>
        </form>
      </div>

      <!-- Mobile Menu Button -->
      <div class="lg:hidden">
        <button onclick="toggleMenu()" class="text-white text-xl">☰</button>
      </div>

    </div>

    <!-- Mobile Dropdown -->
    <div id="mobileMenu" class="hidden flex flex-col space-y-3 pb-4 lg:hidden text-sm">
      <a href="/">Home</a>
      <a href="/browse">Product</a>
      <a href="/cart">Cart</a>
      <a href="/repairs">Repairs</a>
      <a href="/about_us">About Us</a>

      {% if not current_user.is_authenticated %}
        <a href="/login" class="font-bold">Login</a>
      {% else %}
        <a href="/logout">Logout</a>
      {% endif %}
    </div>

  </div>
</nav>

<script>
  function toggleMenu() {
    document.getElementById("mobileMenu").classList.toggle("hidden");
  }

  function toggleUserMenu() {
    document.getElementById("userMenu").classList.toggle("hidden");
  }

  document.addEventListener("click", function (event) {
    const menu = document.getElementById("userMenu");
    const button = event.target.closest("button");

    if (!button || !button.onclick?.toString().includes("toggleUserMenu")) {
      menu.classList.add("hidden");
    }
  });

  const links = document.querySelectorAll(".nav-link");
  const currentPage = window.location.pathname;

  links.forEach(link => {
    if (link.getAttribute("href") === currentPage) {
      link.classList.add("text-[#6fb7ff]", "border-b-2", "border-[#6fb7ff]", "pb-1");
    }
  });
</script>