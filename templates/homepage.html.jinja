<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>

    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .flash-msg {
            animation: fadeIn 0.3s ease forwards;
            transition: all 0.5s ease;
        }
    </style>
</head>

<body class="min-h-screen flex flex-col bg-[#0b2c4d] text-[#d6ecff] font-[Inter]">

<div id="mainContent"
     class="flex flex-col flex-grow transition-all duration-300"
     style="margin-right: 0;">

    <!-- KEEP AI CHAT -->
    {% include "components/ai_chat.html.jinja" %}

    <!-- NAVBAR -->
    {% include "components/navbar.html.jinja" %}

    <main class="flex-grow">

        <!-- FLASH MESSAGES -->
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}

            <div id="flash-container"
                 class="fixed top-5 right-5 z-[9999] space-y-3">

                {% for category, message in messages %}

                <div class="flash-msg px-5 py-3 rounded-xl shadow-lg
                    font-bold text-sm border

                    {% if category == 'success' %}
                        bg-[#0f5e3a] text-[#b6ffd6] border-[#2aff9a]
                    {% else %}
                        bg-red-600 text-white border-red-400
                    {% endif %}">

                    {{ message }}

                </div>

                {% endfor %}

            </div>

            {% endif %}
        {% endwith %}

        <!-- HERO SECTION -->
        <div class="flex flex-col lg:flex-row
                    items-center justify-between
                    gap-8
                    px-6 py-12 lg:px-20 lg:py-20">

            <!-- LEFT PANEL -->
            <div class="w-full lg:w-[30%]
                        border-2 border-dashed border-[#6fb7ff]
                        p-6">

                <h1 class="text-2xl lg:text-3xl
                           uppercase tracking-[2px]
                           mb-4 font-bold">

                    Project Overview

                </h1>

                <p class="leading-relaxed text-gray-200">

                    Technology repair guides designed to help users safely
                    diagnose and repair electronic devices while reducing
                    electronic waste.

                </p>

            </div>

            <!-- CENTER LOGO -->
            <div class="border-2 border-dashed border-[#6fb7ff]
                        flex items-center justify-center
                        w-64 h-64 lg:w-72 lg:h-72">

                <img src="/static/products/Blueprint Logo.png"
                     class="w-full h-full object-contain">

            </div>

            <!-- RIGHT PANEL -->
            <div class="w-full lg:w-[30%]
                        border-2 border-dashed border-[#6fb7ff]
                        p-6">

                <h1 class="text-2xl lg:text-3xl
                           uppercase tracking-[2px]
                           mb-4 font-bold">

                    System Goal

                </h1>

                <p class="leading-relaxed text-gray-200">

                    Enable users to repair devices independently using
                    step-by-step visual instructions and intelligent diagnostics.

                </p>

            </div>

        </div>

        <!-- SECTION HEADER -->
        <div class="text-center
                    py-4
                    border-t border-b border-[#6fb7ff]
                    tracking-[3px]
                    text-sm lg:text-lg">

            POPULAR FIXES — MODULE VIEW

        </div>

        <!-- GUIDES GRID -->
        <div class="px-6 lg:px-20 py-10">

            <div class="grid
                        grid-cols-2
                        sm:grid-cols-3
                        md:grid-cols-4
                        lg:grid-cols-5
                        gap-4">

                {% for x in guides %}

                <a href="/repair-item/{{ x['ID'] }}"
                   class="bg-[#1a3a5a]
                          rounded-xl
                          overflow-hidden
                          hover:ring-2
                          hover:ring-[#6fb7ff]
                          hover:scale-[1.02]
                          transition-all duration-200">

                    <img src="{{ x['Image'] }}"
                         class="aspect-square
                                w-full
                                object-contain
                                bg-white
                                p-4">

                    <div class="p-3">

                        <p class="font-bold text-white text-sm">

                            {{ x["Name"] }}

                        </p>

                    </div>

                </a>

                {% endfor %}

            </div>

        </div>

    </main>

    <!-- FOOTER -->
    {% include "components/footer.html.jinja" %}

</div>

<!-- AUTO REMOVE FLASH -->
<script>

document.addEventListener("DOMContentLoaded", () => {

    setTimeout(() => {

        document.querySelectorAll('.flash-msg').forEach(msg => {

            msg.style.opacity = "0";
            msg.style.transform = "translateY(-10px)";

            setTimeout(() => {

                msg.remove();

            }, 500);

        });

    }, 3000);

});

</script>

</body>
</html>