<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>

    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <style>

        @keyframes fadeIn {

            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .toast {
            animation: fadeIn 0.3s ease forwards;
        }

    </style>

</head>

<body class="min-h-screen flex flex-col text-sm lg:text-xl bg-[#0b2c4d] text-[#d6ecff]">

<div id="mainContent"
     class="flex flex-col flex-grow transition-all duration-300"
     style="margin-right: 0;">

{% include "components/ai_chat.html.jinja" %}
{% include "components/navbar.html.jinja" %}

<!-- FLASH CONTAINER -->
<div id="flash-container"
     class="fixed top-5 right-5 z-[9999] space-y-3">
</div>

<main class="flex-grow">

    <!-- LOAD FLASHES -->
    {% with messages = get_flashed_messages(with_categories=true) %}
      {% if messages %}

        <script>

            document.addEventListener("DOMContentLoaded", () => {

                const flashContainer =
                    document.getElementById("flash-container");

                function showFlash(message, category = "success") {

                    const div =
                        document.createElement("div");

                    div.className = `
                        toast px-5 py-3 rounded-xl shadow-lg
                        font-bold text-sm border transition duration-300

                        ${category === "error"
                            ? "bg-red-600 text-white border-red-400"
                            : "bg-[#0f5e3a] text-[#b6ffd6] border-[#2aff9a]"
                        }
                    `;

                    div.innerText = message;

                    flashContainer.appendChild(div);

                    setTimeout(() => {

                        div.style.opacity = "0";
                        div.style.transform =
                            "translateY(-10px)";

                        setTimeout(() => {

                            div.remove();

                        }, 300);

                    }, 3000);
                }

                {% for category, message in messages %}

                    showFlash(
                        {{ message|tojson }},
                        "{{ category }}"
                    );

                {% endfor %}

            });

        </script>

      {% endif %}
    {% endwith %}

    <!-- HERO -->
    <div class="flex flex-col lg:flex-row
                items-center justify-between
                px-6 py-12 lg:px-20 lg:py-20
                space-y-6 lg:space-y-0 lg:space-x-10">

        <!-- LEFT -->
        <div style="border:2px dashed #6fb7ff; padding:25px;"
             class="w-full lg:w-[30%]">

            <h1 style="
                font-size:28px;
                margin-bottom:15px;
                text-transform:uppercase;
                letter-spacing:2px;">

                Project Overview

            </h1>

            <p style="line-height:1.6;">

                Technology repair guides designed to help users safely
                diagnose and repair electronic devices while reducing
                electronic waste.

            </p>

        </div>

        <!-- CENTER -->
        <div style="
            border:2px dashed #6fb7ff;
            display:flex;
            align-items:center;
            justify-content:center;
            background-color:#0b2c4d;"

            class="w-64 h-64 lg:w-65 lg:h-65">

            <img src="/static/products/Blueprint Logo.png"
                 style="width:100%; height:100%;">

        </div>

        <!-- RIGHT -->
        <div style="border:2px dashed #6fb7ff; padding:25px;"
             class="w-full lg:w-[30%]">

            <h1 style="
                font-size:28px;
                margin-bottom:15px;
                text-transform:uppercase;
                letter-spacing:2px;">

                System Goal

            </h1>

            <p style="line-height:1.6;">

                Enable users to repair devices independently using
                step-by-step visual instructions and intelligent diagnostics.

            </p>

        </div>

    </div>

    <!-- SECTION LABEL -->
    <div style="
        padding:18px;
        background-color:#0b2c4d;
        border-top:2px dashed #6fb7ff;
        border-bottom:2px dashed #6fb7ff;
        text-align:center;
        letter-spacing:3px;
        font-size:18px;">

        POPULAR FIXES — MODULE VIEW

    </div>

    <!-- GRID -->
    <div class="flex flex-col lg:flex-row
                items-center justify-center
                gap-8 lg:gap-12
                px-6 py-12 lg:px-20">

        <div class="grid
                    grid-cols-2
                    sm:grid-cols-3
                    md:grid-cols-4
                    lg:grid-cols-5
                    gap-3 sm:gap-4">

            {% for x in guides %}

            <a href="/repair-item/{{ x['ID'] }}"
               class="bg-[#1a3a5a]
                      rounded-xl
                      overflow-hidden
                      hover:ring-2
                      hover:ring-[#6fb7ff]
                      transition-all duration-200">

                <img src="{{ x['Image'] }}"
                     class="aspect-square
                            bg-white
                            p-4
                            object-contain
                            w-full">

                <div class="p-3">

                    <p class="text-white text-base font-bold">

                        {{ x["Name"] }}

                    </p>

                </div>

            </a>

            {% endfor %}

        </div>

    </div>

</main>

{% include "components/footer.html.jinja" %}

</div>
</body>
</html>