<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home</title>

  <link href="/static/style.css" rel="stylesheet">
  <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">

  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .flash-msg {
      animation: fadeIn 0.3s ease forwards;
      transition: all 0.5s ease;
    }
  </style>
</head>

<body class="min-h-screen flex flex-col bg-[#0b2c4d] text-[#d6ecff] font-[Inter]">

{% include "components/navbar.html.jinja" %}

<main class="flex-grow">

  <!-- FLASH MESSAGES -->
  {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
      <div class="px-6 lg:px-20 pt-6 space-y-3">

        {% for category, message in messages %}
          <div class="flash-msg px-4 py-3 rounded-lg font-semibold shadow-md
            {% if category == 'success' %}
              bg-green-500 text-white
            {% else %}
              bg-red-500 text-white
            {% endif %}">
            {{ message }}
          </div>
        {% endfor %}

      </div>
    {% endif %}
  {% endwith %}

  <!-- HERO SECTION -->
  <div class="flex flex-col lg:flex-row items-center justify-between px-6 py-12 lg:px-20 lg:py-20 gap-10">

    <!-- LEFT -->
    <div class="border-2 border-dashed border-[#6fb7ff] p-6 w-full lg:w-[30%]">
      <h1 class="text-2xl font-bold mb-4 uppercase tracking-widest">
        Project Overview
      </h1>
      <p class="leading-relaxed text-gray-200">
        Technology repair guides designed to help users safely diagnose and repair electronic devices while reducing electronic waste.
      </p>
    </div>

    <!-- CENTER LOGO -->
    <div class="border-2 border-dashed border-[#6fb7ff] flex items-center justify-center w-64 h-64">
      <img src="/static/products/Blueprint Logo.png" class="w-full h-full object-contain">
    </div>

    <!-- RIGHT -->
    <div class="border-2 border-dashed border-[#6fb7ff] p-6 w-full lg:w-[30%]">
      <h1 class="text-2xl font-bold mb-4 uppercase tracking-widest">
        System Goal
      </h1>
      <p class="leading-relaxed text-gray-200">
        Enable users to repair devices independently using step-by-step visual instructions and intelligent diagnostics.
      </p>
    </div>

  </div>

  <!-- SECTION HEADER -->
  <div class="text-center py-4 border-t border-b border-[#6fb7ff] tracking-widest">
    POPULAR FIXES — MODULE VIEW
  </div>

  <!-- GRID -->
  <div class="px-6 lg:px-20 py-10">

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">

      {% for x in guides %}
      <a href="/repair-item/{{ x['ID'] }}"
         class="bg-[#1a3a5a] rounded-xl overflow-hidden hover:ring-2 hover:ring-[#6fb7ff] transition">

        <img src="{{ x['Image'] }}"
             class="aspect-square w-full object-contain bg-white p-4">

        <div class="p-3">
          <p class="font-bold text-white text-sm">
            {{ x["Name"] }}
          </p>
        </div>

      </a>
      {% endfor %}

    </div>

  </div>

</main>

{% include "components/footer.html.jinja" %}

<!-- AUTO REMOVE FLASH -->
<script>
document.addEventListener("DOMContentLoaded", () => {
  setTimeout(() => {
    document.querySelectorAll('.flash-msg').forEach(msg => {
      msg.style.opacity = "0";
      msg.style.transform = "translateY(-10px)";
      setTimeout(() => msg.remove(), 500);
    });
  }, 3000);
});
</script>

</body>
</html>