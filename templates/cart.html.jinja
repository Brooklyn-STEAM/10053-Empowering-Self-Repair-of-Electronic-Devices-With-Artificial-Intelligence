<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cart</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">
</head>

{% include "components/ai_chat.html.jinja" %}

<body class="min-h-screen flex flex-col bg-[#0b2c4d] text-[#d6ecff] font-[Inter]">

{% include "components/navbar.html.jinja" %}

<main class="flex-grow px-4 lg:px-8 py-6 max-w-5xl mx-auto w-full">

    <h1 class="text-3xl font-bold mb-6">Your Shopping Cart</h1>

    {% if cart|length == 0 %}
        <p class="text-lg text-gray-400">Your cart is empty.</p>
    {% else %}

    {% set ns = namespace(total=0) %}

    {% for x in cart %}
    {% set ns.total = ns.total + (x['Price'] * x['Quantity']) %}

    <div class="bg-[#0e3a63] border border-[#6fb7ff] rounded-xl p-4 mb-4 shadow-lg">

        <!-- MOBILE -->
        <div class="flex flex-col gap-4 lg:hidden">

            <div class="flex gap-4 items-center">
                <img src="{{ x['Image'] }}"
                     class="h-20 w-20 object-contain rounded border border-[#6fb7ff]">

                <div class="font-semibold text-sm">
                    {{ x['Name'] }}
                </div>
            </div>

            <form method="post"
                  action="/cart/{{ x['ProductID'] }}/update_qty"
                  class="flex gap-2">

                <input name="quantity"
                       type="number"
                       value="{{ x['Quantity'] }}"
                       min="1"
                       max="20"
                       class="flex-1 rounded px-3 py-2 text-center bg-[#0b2c4d] border border-[#6fb7ff]">

                <button type="submit"
                        class="bg-[#6fb7ff] hover:bg-[#5aa7f0] text-[#0b2c4d] px-4 py-2 rounded font-bold">
                    Update
                </button>
            </form>

            <div class="flex justify-between text-sm text-gray-300">
                <span>Price:</span>
                <span>${{ "%.2f"|format(x['Price']) }}</span>
            </div>

            <div class="flex justify-between font-semibold">
                <span>Subtotal:</span>
                <span>${{ "%.2f"|format(x['Price'] * x['Quantity']) }}</span>
            </div>

            <form method="post" action="/cart/{{ x['ProductID'] }}/remove">
                <button class="w-full bg-red-500 hover:bg-red-600 text-white py-2 rounded">
                    Remove
                </button>
            </form>

        </div>

        <!-- DESKTOP -->
        <div class="hidden lg:grid grid-cols-6 items-center gap-4">

            <img src="{{ x['Image'] }}"
                 class="h-24 w-24 object-contain rounded border border-[#6fb7ff]">

            <div class="col-span-2 font-semibold">
                {{ x['Name'] }}
            </div>

            <div class="text-center">
                <form method="post"
                      action="/cart/{{ x['ProductID'] }}/update_qty"
                      class="flex items-center gap-2 justify-center">

                    <input name="quantity"
                           type="number"
                           value="{{ x['Quantity'] }}"
                           min="1"
                           max="20"
                           class="w-16 rounded px-2 py-1 text-center bg-[#0b2c4d] border border-[#6fb7ff]">

                    <button type="submit"
                            class="bg-[#6fb7ff] hover:bg-[#5aa7f0] text-[#0b2c4d] px-3 py-1 rounded text-sm font-bold">
                        Update
                    </button>
                </form>
            </div>

            <div class="text-center">
                <form method="post"
                      action="/cart/{{ x['ProductID'] }}/remove">

                    <button class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded text-sm">
                        Remove
                    </button>
                </form>
            </div>

            <div class="text-right">
                <div class="font-semibold">
                    ${{ "%.2f"|format(x['Price']) }}
                </div>

                <div class="text-sm text-gray-300">
                    Subtotal: ${{ "%.2f"|format(x['Price'] * x['Quantity']) }}
                </div>
            </div>

        </div>

    </div>

    {% endfor %}

    <!-- TOTAL BOX -->
    <div class="mt-6 flex justify-end" data-aos="fade-up" data-aos-duration="800">

        <div class="bg-[#0e3a63] border border-[#6fb7ff] rounded-xl p-4 w-full max-w-xs shadow-lg text-left">
            <div class="text-gray-400 text-sm">
                {{ cart|length }} items
            </div>

            <h2 class="text-2xl font-bold mt-2">
                Total: ${{ "%.2f"|format(ns.total) }}
            </h2>

<a href="{{ url_for('checkout') }}"
   class="block mt-4 w-full text-center font-semibold px-4 py-2 rounded-lg
          bg-[#6fb7ff] hover:bg-[#5aa7f0]
          text-[#0b2c4d]
          transition-all duration-200
          hover:shadow-md active:scale-95">

    Checkout

</a>

        </div>

    </div>

    {% endif %}

    <!-- BACK -->
    <a href="{{ url_for('browse') }}">
        <button class="w-full lg:w-auto bg-[#111] hover:bg-black font-bold text-white mt-4 rounded-lg px-4 py-3">
            ⬅ Go Back
        </button>
    </a>

</main>

{% include "components/footer.html.jinja" %}

</body>
</html>