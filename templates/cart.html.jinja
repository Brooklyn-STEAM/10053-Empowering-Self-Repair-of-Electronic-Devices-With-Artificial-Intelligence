<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cart</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">
</head>

{% include "components/ai_chat.html.jinja" %}

<body class="min-h-screen flex flex-col bg-[#0b2c4d] text-[#d6ecff] leading-relaxed tracking-wide font-[Inter]">

    {% include "components/navbar.html.jinja" %}

    <main class="flex-grow px-4 lg:px-8 py-6 max-w-5xl mx-auto w-full">

        <h1 class="text-2xl lg:text-3xl font-bold mb-6">
            Your Shopping Cart
        </h1>

        {% if cart|length == 0 %}

            <p class="text-lg">
                Your cart is empty.
            </p>

        {% else %}

            {% set ns = namespace(total=0) %}

            {% for x in cart %}
            {% set ns.total = ns.total + (x['Price'] * x['Quantity']) %}

            <div class="bg-white text-black rounded-lg shadow p-4 mb-4">

                <!-- MOBILE LAYOUT -->
                <div class="flex flex-col gap-4 lg:hidden">

                    <!-- Product Info -->
                    <div class="flex gap-4 items-center">
                        <img src="{{ x['Image'] }}"
                             class="h-20 w-20 object-contain rounded border">

                        <div class="font-semibold text-sm">
                            {{ x['Name'] }}
                        </div>
                    </div>

                    <!-- Quantity Update -->
                    <form method="post"
                          action="/cart/{{ x['ProductID'] }}/update_qty"
                          class="flex gap-2">

                        <input name="quantity"
                               type="number"
                               value="{{ x['Quantity'] }}"
                               min="1"
                               max="20"
                               class="flex-1 border rounded px-3 py-2 text-center">

                        <button type="submit"
                                class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded">
                            Update
                        </button>
                    </form>

                    <!-- Price -->
                    <div class="flex justify-between text-sm">
                        <span>Price:</span>
                        <span>${{ x['Price'] }}</span>
                    </div>

                    <!-- Subtotal -->
                    <div class="flex justify-between font-semibold">
                        <span>Subtotal:</span>
                        <span>${{ x['Price'] * x['Quantity'] }}</span>
                    </div>

                    <!-- Remove -->
                    <form method="post"
                          action="/cart/{{ x['ProductID'] }}/remove">

                        <button type="submit"
                                class="w-full bg-red-500 hover:bg-red-600 text-white py-2 rounded">
                            Remove
                        </button>
                    </form>

                </div>

                <!-- DESKTOP LAYOUT -->
                <div class="hidden lg:grid grid-cols-6 items-center gap-4">

                    <img src="{{ x['Image'] }}"
                         class="h-24 w-24 object-contain rounded border">

                    <div class="col-span-2 font-semibold">
                        {{ x['Name'] }}
                    </div>

                    <div class="text-center">
                        <form method="post"
                              action="/cart/{{ x['ProductID'] }}/update_qty"
                              class="flex items-center gap-2 justify-center">

                            <input name="quantity"
                                   type="number"
                                   value="{{ x['Quantity'] }}"
                                   min="1"
                                   max="20"
                                   class="w-16 border rounded px-2 py-1 text-center">

                            <button type="submit"
                                    class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded text-sm">
                                Update
                            </button>
                        </form>
                    </div>

                    <div class="text-center">
                        <form method="post"
                              action="/cart/{{ x['ProductID'] }}/remove">

                            <button type="submit"
                                    class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded text-sm">
                                Remove
                            </button>
                        </form>
                    </div>

                    <div class="text-right">
                        <div class="font-semibold">
                            ${{ x['Price'] }}
                        </div>

                        <div class="text-sm text-gray-500">
                            Subtotal: ${{ x['Price'] * x['Quantity'] }}
                        </div>
                    </div>

                </div>

            </div>

            {% endfor %}

            <!-- Total -->
            <div class="mt-6 flex justify-center lg:justify-end">

                <div class="bg-white text-black rounded-lg shadow p-4 w-full max-w-sm text-right">

                    <h2 class="text-xl font-bold">
                        Total: ${{ ns.total }}
                    </h2>

                    <a href="{{ url_for('checkout') }}"
                       class="block mt-4 bg-blue-500 hover:bg-black text-white font-bold px-4 py-3 rounded-lg text-center transition">
                        Proceed to Checkout
                    </a>

                </div>

            </div>

        {% endif %}

        <!-- Back Button -->
        <a href="{{ url_for('browse') }}">
            <button class="w-full lg:w-auto bg-black font-bold text-white mt-4 rounded-lg px-4 py-3">
                ⬅ Go Back
            </button>
        </a>

    </main>

    {% include "components/footer.html.jinja" %}

</body>
</html>