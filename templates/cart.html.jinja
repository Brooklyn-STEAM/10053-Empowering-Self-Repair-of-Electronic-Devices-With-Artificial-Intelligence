<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cart</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">
</head>

<body class="min-h-screen flex flex-col bg-[#0b2c4d] text-[#d6ecff] font-[Inter]">
<div id="mainContent" class="transition-all duration-300 flex-grow flex flex-col" 
style="margin-right: 0; ">

{% include "components/ai_chat.html.jinja" %}
{% include "components/navbar.html.jinja" %}

<main class="flex-1 max-w-6xl mx-auto p-6 space-y-8 w-full">

    <!-- HEADER -->
    <div class="text-center">
        <h1 class="text-4xl font-bold">Your Shopping Cart</h1>

        <p class="text-gray-300 mt-2">
            Review and manage your cart items
        </p>
    </div>

    <!-- FLASH -->
    {% with messages = get_flashed_messages(with_categories=true) %}
      {% if messages %}
        <div class="space-y-3">
          {% for category, message in messages %}
            <div class="flash-msg px-4 py-3 rounded-xl font-semibold shadow-lg
                        bg-green-500 text-white border border-green-300">
              {{ message }}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    {% endwith %}

    {% if cart|length == 0 %}

        <!-- EMPTY CART -->
        <div class="bg-[#0e3a63]
                    border border-[#6fb7ff]
                    rounded-xl
                    p-10
                    text-center
                    shadow-lg">

            <p class="text-xl text-gray-300">
                Your cart is empty.
            </p>

            <a href="{{ url_for('browse') }}"
               class="inline-block mt-6
                      bg-[#6fb7ff]
                      hover:bg-blue-400
                      text-[#0b2c4d]
                      font-bold
                      px-6 py-3
                      rounded-lg
                      transition">

                Browse Products

            </a>

        </div>

    {% else %}

    {% set ns = namespace(total=0) %}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- CART ITEMS -->
        <div class="lg:col-span-2 space-y-4">

            {% for x in cart %}
            {% set ns.total = ns.total + (x['Price'] * x['Quantity']) %}

            <div class="bg-[#0e3a63]
                        border border-[#6fb7ff]
                        rounded-xl
                        shadow-lg
                        p-4
                        flex flex-col sm:flex-row
                        items-center
                        gap-4">

                <!-- IMAGE -->
                <div class="w-24 h-24
                            bg-[#0b2c4d]
                            rounded-lg
                            overflow-hidden
                            border border-[#1f4f7a]">

                    <img src="{{ x['Image'] }}"
                         class="w-full h-full object-contain">
                </div>

                <!-- INFO -->
                <div class="flex-1 text-center sm:text-left">

                    <h2 class="font-bold text-lg">
                        {{ x['Name'] }}
                    </h2>

                    <p class="text-sm text-gray-300 mt-1">
                        Unit Price:
                        ${{ "%.2f"|format(x['Price']) }}
                    </p>

                    <p class="text-sm text-gray-400">
                        Quantity:
                        {{ x['Quantity'] }}
                    </p>

                </div>

                <!-- QUANTITY + BUTTONS -->
                <div class="flex flex-wrap items-center justify-center gap-2">

                    <!-- UPDATE -->
                    <form method="post"
                          action="/cart/{{ x['ProductID'] }}/update_qty"
                          class="flex items-center gap-2">

                        <input name="quantity"
                               type="number"
                               value="{{ x['Quantity'] }}"
                               min="1"
                               max="20"
                               class="w-16 bg-[#0b2c4d]
                                      border border-[#6fb7ff]
                                      rounded-lg
                                      px-2 py-2
                                      text-center
                                      text-white
                                      focus:outline-none
                                      focus:ring-2
                                      focus:ring-[#6fb7ff]">

                        <button type="submit"
                                class="bg-[#6fb7ff]
                                       hover:bg-blue-400
                                       text-[#0b2c4d]
                                       font-bold
                                       px-4 py-2
                                       rounded-lg
                                       transition duration-200
                                       shadow-md hover:shadow-lg
                                       active:scale-95">

                            Update

                        </button>

                    </form>

                    <!-- REMOVE -->
                    <form method="post"
                          action="/cart/{{ x['ProductID'] }}/remove">

                        <button
                            class="bg-red-500
                                   hover:bg-red-600
                                   text-white
                                   text-sm
                                   font-semibold
                                   px-4 py-2
                                   rounded-lg
                                   transition duration-200
                                   shadow-md hover:shadow-lg
                                   active:scale-95">

                            Remove

                        </button>

                    </form>

                </div>

                <!-- SUBTOTAL -->
                <div class="text-right min-w-[120px]">

                    <p class="text-xs text-gray-300">
                        Subtotal
                    </p>

                    <p class="text-xl font-bold text-green-400">
                        ${{ "%.2f"|format(x['Price'] * x['Quantity']) }}
                    </p>

                </div>

            </div>

            {% endfor %}

        </div>

        <!-- SUMMARY -->
        <div class="bg-[#0e3a63]
                    border border-[#6fb7ff]
                    rounded-xl
                    shadow-lg
                    p-6
                    h-fit
                    sticky top-6">

            <h2 class="text-2xl font-bold border-b border-[#6fb7ff] pb-3 mb-4">
                Cart Summary
            </h2>

            <div class="space-y-2">

                <div class="flex justify-between text-gray-300">
                    <span>Items</span>
                    <span>{{ cart|length }}</span>
                </div>

                <div class="flex justify-between text-gray-300">
                    <span>Shipping</span>
                    <span>Free</span>
                </div>

            </div>

            <div class="border-t border-[#6fb7ff] mt-4 pt-4">

                <p class="text-gray-300 text-sm">
                    Total
                </p>

                <div class="text-4xl font-bold text-green-400">
                    ${{ "%.2f"|format(ns.total) }}
                </div>

            </div>

            <!-- CHECKOUT -->
            <a href="{{ url_for('checkout') }}"
               class="block mt-6 w-full text-center
                      bg-[#6fb7ff]
                      hover:bg-blue-400
                      text-[#0b2c4d]
                      font-bold
                      py-3
                      rounded-lg
                      transition">

                Proceed to Checkout

            </a>

            <!-- CONTINUE SHOPPING -->
            <a href="{{ url_for('browse') }}"
               class="block mt-3 w-full text-center
                      bg-[#0b2c4d]
                      hover:bg-[#081f36]
                      border border-[#6fb7ff]
                      text-white
                      font-bold
                      py-3
                      rounded-lg
                      transition">

                Continue Shopping

            </a>

        </div>

    </div>

    {% endif %}

</main>

{% include "components/footer.html.jinja" %}

<!-- AUTO DISAPPEAR FLASH -->
<script>
document.addEventListener("DOMContentLoaded", () => {

    setTimeout(() => {

        const messages = document.querySelectorAll('.flash-msg');

        messages.forEach(msg => {

            msg.style.transition = "all 0.5s ease";
            msg.style.opacity = "0";
            msg.style.transform = "translateY(-10px)";

            setTimeout(() => {
                msg.remove();
            }, 500);

        });

    }, 3000);

});
</script>

</body>
</html>