<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">

    <style>
        .glass {
            backdrop-filter: blur(10px);
            background: rgba(11, 44, 77, 0.6);
            transition: 0.3s ease;
        }

        .glass:hover {
            box-shadow: 0 0 30px rgba(111, 183, 255, 0.2);
        }

        .soft-glow {
            box-shadow: 0 0 25px rgba(111, 183, 255, 0.12);
        }
    </style>
</head>

<body class="min-h-screen flex flex-col bg-[#0b2c4d] text-[#d6ecff] font-[Inter]">

{% include "components/navbar.html.jinja" %}

<main class="flex-1 flex items-center justify-center p-6">

    <div class="w-full max-w-5xl grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- LEFT SIDE -->
        <div class="glass border border-[#6fb7ff]/30 rounded-2xl p-6 soft-glow">

            <h2 class="text-2xl font-bold mb-6 border-b border-[#6fb7ff]/30 pb-3">
                Account Summary
            </h2>

            <div class="space-y-4">

                <div class="bg-[#0e3a63] border border-[#6fb7ff]/20 p-4 rounded-lg">
                    <p class="text-xs text-gray-300">Name</p>
                    <p class="font-semibold">{{ current_user.name }}</p>
                </div>

                <div class="bg-[#0e3a63] border border-[#6fb7ff]/20 p-4 rounded-lg">
                    <p class="text-xs text-gray-300">Email</p>
                    <p class="font-semibold">{{ current_user.email }}</p>
                </div>

                <div class="bg-[#0e3a63] border border-[#6fb7ff]/20 p-4 rounded-lg">
                    <p class="text-xs text-gray-300">Address</p>
                    <p class="font-semibold">
                        {{ current_user.address or "No address set" }}
                    </p>
                </div>

            </div>

        </div>

        <!-- RIGHT SIDE -->
        <div class="glass border border-[#6fb7ff]/30 rounded-2xl p-6 soft-glow">

            <!-- FLASH MESSAGES -->
            {% with messages = get_flashed_messages(with_categories=true) %}
                {% if messages %}
                    {% for category, message in messages %}
                        <div class="mb-4 p-3 rounded text-center font-semibold
                            {% if category == 'success' %}
                                bg-green-500 text-white
                            {% else %}
                                bg-red-500 text-white
                            {% endif %}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endif %}
            {% endwith %}

            <h2 class="text-2xl font-bold mb-6 border-b border-[#6fb7ff]/30 pb-3">
                Edit Profile
            </h2>

            <form action="/profile/update" method="POST" class="space-y-5">

                <!-- NAME -->
                <div>
                    <label class="text-sm text-gray-300">Name</label>
                    <input 
                        type="text"
                        name="name"
                        value="{{ current_user.name }}"
                        class="w-full mt-1 p-3 rounded-lg bg-[#0e3a63] border border-[#6fb7ff]/30 focus:border-[#6fb7ff] outline-none"
                        required
                    >
                </div>

                <!-- EMAIL -->
                <div>
                    <label class="text-sm text-gray-300">Email</label>
                    <input 
                        type="email"
                        name="email"
                        value="{{ current_user.email }}"
                        class="w-full mt-1 p-3 rounded-lg bg-[#0e3a63] border border-[#6fb7ff]/30 focus:border-[#6fb7ff] outline-none"
                        required
                    >
                </div>

                <!-- ADDRESS -->
                <div>
                    <label class="text-sm text-gray-300">Address</label>
                    <input 
                        type="text"
                        name="address"
                        value="{{ current_user.address }}"
                        class="w-full mt-1 p-3 rounded-lg bg-[#0e3a63] border border-[#6fb7ff]/30 focus:border-[#6fb7ff] outline-none"
                    >
                </div>

                <!-- BUTTON -->
                <button 
                    type="submit"
                    class="w-full bg-[#6fb7ff] text-[#0b2c4d] font-bold py-3 rounded-lg hover:bg-blue-400 transition active:scale-95"
                >
                    Save Changes
                </button>

            </form>

        </div>

    </div>

</main>

{% include "components/footer.html.jinja" %}

</body>
</html>