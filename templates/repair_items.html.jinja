<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ item.Name }} - Repair Details</title>
    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>


<body class="min-h-screen flex flex-col text-sm lg:text-xl bg-[#0f2f4f]">
<div id="mainContent" class="transition-all duration-300" style="margin-right: 0; flex-grow flex flex-col">

{% include "components/ai_chat.html.jinja" %}
    {% include "components/navbar.html.jinja" %}

    <main class="flex-grow container mx-auto px-4 py-8 max-w-6xl">
        
        <!-- Device Name -->
        <h1 class="text-3xl lg:text-4xl font-bold text-white mb-6">
            {{ item["Name"] }}
        </h1>

        <!-- Image + Description (two columns on larger screens) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mb-12">
            <!-- Image column – constrained size, subtle card -->
            <div class="bg-[#1a3a5a] rounded-xl p-4 flex items-center justify-center">
                <img src="{{ item['Image'] }}" 
                     alt="{{ item['Name'] }}"
                     class="max-w-full max-h-80 object-contain">
            </div>
            
            <!-- Description column – also a card, not too wide -->
            <div class="bg-[#1a3a5a] rounded-xl p-6">
                <h2 class="text-xl font-semibold text-white mb-3">Description</h2>
                <p class="text-gray-300 leading-relaxed">
                    {{ item ["Description"] }}
                </p>
                <!-- If you have extra specs, add them here -->
            </div>
        </div>

        <!-- Repair Guides Section -->
        <div class="mt-8">
            <div class="flex items-center gap-4 mb-4">
                <h2 class="text-2xl font-bold text-white">Repair Guides</h2>
                <hr class="flex-grow border-t-2 border-[#1a3a5a]">
            </div>

            <!-- Guide list – replace with real data from backend -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {% if guides %}
                    {% for x in guides %}
                        <a href="/guide/{{ x['ID'] }}" 
                        class="bg-[#1a3a5a] rounded-xl p-5 hover:bg-[#2a4a6a] transition duration-150 block">

                            <!-- Guide Name -->
                            <h3 class="text-lg font-semibold text-[#6fb7ff] mb-2">
                                {{ x["Name"] }}
                            </h3>

                            <!-- Time + Difficulty -->
                            <div class="flex items-center font-bold justify-between text-sm">
                                
                                <!-- Time -->
                                <span class="text-gray-300">
                                    {{ x["Time_Estimate"] }}
                                </span>

                                <!-- Difficulty Badge -->
                                <span class="
                                    px-3 py-1 rounded-full text-xs font-semibold
                                    {% if x['Difficulty'] == 'Easy' %}
                                        bg-green-500/20 text-green-400
                                    {% elif x['Difficulty'] == 'Moderate' %}
                                        bg-yellow-500/20 text-yellow-400
                                    {% else %}
                                        bg-red-500/20 text-red-400
                                    {% endif %}
                                ">
                                    {{ x["Difficulty"] }}
                                </span>

                            </div>

                        </a>
                    {% endfor %}
                {% else %}
                    <p class="p-6 text-gray-400 text-center col-span-full">
                        No repair guides available for this device yet.
                    </p>
                {% endif %}
            </div>
        </div>

    </main>

    {% include "components/footer.html.jinja" %}
</div>
</body>
</html>