<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <title>{{ product['Name'] }}</title>
  <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">
</head>

<body class="bg-[#0b2c4d] text-[#d6ecff] font-mono min-h-screen flex flex-col">

{% include "components/navbar.html.jinja" %}

<main class="flex-grow px-6 py-10">

  <!-- PRODUCT SECTION -->
  <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-10 items-start">

    <!-- LEFT: IMAGE -->
    <div class="bg-[#123d66] rounded-2xl p-6 shadow-xl">
      <img src="{{ product['Image'] }}" 
           alt="{{ product['Name'] }}"
           class="w-full h-[400px] object-contain rounded-lg">
    </div>

    <!-- RIGHT: INFO -->
    <div class="space-y-6">

      <div>
        <h1 class="text-4xl font-bold mb-2">
          {{ product['Name'] }}
        </h1>
        <p class="text-3xl text-yellow-400 font-bold">
          ${{ product['Price'] }}
        </p>
      </div>

      <div class="bg-[#123d66] p-6 rounded-xl shadow-md">
        <p class="text-[#cde7ff] leading-relaxed">
          {{ product['Description'] }}
        </p>
      </div>

      <!-- ADD TO CART -->
      <form method="POST" action="/product/{{ product['ID'] }}/add_to_cart"
            class="bg-[#09223c] p-6 rounded-xl shadow-lg space-y-4">

        <div>
          <label class="block text-sm mb-2 uppercase tracking-wide">
            Quantity
          </label>
          <input type="number" name="qty" value="1" min="1" required
            class="w-24 bg-[#123d66] border border-blue-400 text-center rounded-md p-2 focus:outline-none 
                        focus:ring-2 focus:ring-yellow-400">
        </div>

        <button type="submit"
          class="w-full bg-yellow-500 hover:bg-yellow-600 text-black font-bold py-3 rounded-lg
                 transition transform hover:scale-105 shadow-md">
          Add to Cart
        </button>

      </form>

    </div>
  </div>

{#
  <!-- REVIEWS SECTION -->
  <div class="max-w-4xl mx-auto mt-20">

    <h2 class="text-3xl font-bold mb-8 text-center border-b border-blue-400 pb-4">
      Customer Reviews
    </h2>

    {% if reviews %}
      <div class="space-y-6">
        {% for review in reviews %}
          <div class="bg-[#123d66] p-6 rounded-xl shadow-md">

            <div class="flex justify-between items-center mb-3">
              <h3 class="font-semibold text-lg">
                {{ review['User'] }}
              </h3>
              <span class="text-sm text-blue-300">
                {{ review['CreatedAt'].strftime("%b %d, %Y %I:%M %p") }}
              </span>
            </div>

            <div class="text-yellow-400 mb-2">
              {% for i in range(1, 6) %}
                {% if i <= review['Rating'] %}★{% else %}☆{% endif %}
              {% endfor %}
            </div>

            <p class="text-[#cde7ff]">
              {{ review['Comments'] }}
            </p>

          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="text-center text-blue-300">
        No reviews yet. Be the first to review this product!
      </p>
    {% endif %}
  </div>


  <!-- REVIEW FORM -->
  <div class="max-w-3xl mx-auto mt-16 bg-[#09223c] p-8 rounded-2xl shadow-xl">

    <h2 class="text-2xl font-bold mb-6 text-center">
      Leave a Review
    </h2>

    <form method="POST"
          action="/product/{{ product['ID'] }}/review"
          class="space-y-6">

      <div>
        <label class="block mb-2 text-sm uppercase tracking-wide">
          Rating (1–5)
        </label>
        <input type="number" name="rating" min="1" max="5" required
               class="w-full bg-[#123d66] border border-blue-400
                      rounded-md p-3 focus:outline-none
                      focus:ring-2 focus:ring-yellow-400">
      </div>

      <div>
        <label class="block mb-2 text-sm uppercase tracking-wide">
          Comments
        </label>
        <textarea name="comments" required rows="4"
          class="w-full bg-[#123d66] border border-blue-400
                 rounded-md p-3 focus:outline-none
                 focus:ring-2 focus:ring-yellow-400"></textarea>
      </div>

      <button type="submit"
        class="w-full bg-yellow-500 hover:bg-yellow-600
               text-black font-bold py-3 rounded-lg
               transition transform hover:scale-105">
        Submit Review
      </button> 
      #}

    </form>

  </div>

</main>

{% include "components/footer.html.jinja" %}

</body>
</html>