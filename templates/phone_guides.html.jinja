<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phone Guides</title>
    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

{% include "components/ai_chat.html.jinja" %}
<body class="min-h-screen flex flex-col text-sm lg:text-xl">

{% include "components/navbar.html.jinja" %}

<main class="flex-grow">

<!-- Page Header -->
<section class="max-w-7xl mx-auto mb-8 lg:mb-10">

<div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div> <br>
        <h1 class="text-2xl lg:text-3xl font-extrabold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
        Phone Repair Guides
        </h1>

        <p class="text-blue-500 mt-1 text-sm lg:text-base">
        Find step-by-step guides to repair your phone, with detailed instructions and recommended tools.
        </p>
    </div>
</div>
</section>

<!-- Product Grid -->
<section class="max-w-7xl mx-auto">

<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-4">
    {% for x in guides %}
        <a href="/repair-item/{{ x['ID'] }}" class="bg-[#1a3a5a] rounded-xl overflow-hidden hover:ring-2 hover:ring-[#6fb7ff] transition-all duration-200">
            
            <img src="{{ x['Image'] }}" alt="{{ x['Name'] }}" class="aspect-square bg-white p-4 flex items-center justify-center max-w-full max-h-full object-contain">

            <div class="p-3">
                <p class="text-white text-base leading-tight font-bold">
                    {{ x["Name"] }}
                </p>
            </div>
        
        </a>
    {% endfor %}
</div>

</section>
</main>

{% include "components/footer.html.jinja" %}

</body>
</html>