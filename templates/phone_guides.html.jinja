<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phone Guides</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">
</head>

<body class="min-h-screen flex flex-col bg-[#0b2c4d] text-[#d6ecff] text-sm lg:text-base">

{% include "components/ai_chat.html.jinja" %}
{% include "components/navbar.html.jinja" %}

<main class="flex-grow px-4 py-6 lg:px-8">

<!-- HEADER -->
<section class="max-w-7xl mx-auto mb-8">

<div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">

    <div>
        <h1 class="text-3xl font-bold text-[#6fb7ff]">
            Phone Repair Guides
        </h1>

        <p class="text-[#d6ecff] text-sm">
            Step-by-step guides to repair your phone with recommended tools.
        </p>
    </div>

</div>

</section>

<!-- GRID -->
<section class="max-w-7xl mx-auto">

<div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">

{% for x in guides %}

<div class="bg-[#0e3a63] border border-[#6fb7ff] rounded-2xl overflow-hidden shadow-lg flex flex-col hover:scale-[1.02] transition">

    <!-- IMAGE -->
    <a href="/repair-item/{{ x['ID'] }}"
       class="m-3 p-4 h-44 flex items-center justify-center bg-white rounded-xl overflow-hidden">

        <img src="{{ x['Image'] }}"
             alt="{{ x['Name'] }}"
             class="max-h-full object-contain transition hover:scale-105">

    </a>

    <!-- CONTENT -->
    <div class="p-3 flex flex-col flex-1">

        <a href="/repair-item/{{ x['ID'] }}">
            <h3 class="font-semibold text-[#d6ecff] hover:text-[#6fb7ff] transition">
                {{ x["Name"] }}
            </h3>
        </a>

        <div class="flex-grow"></div>

        <!-- BUTTON -->
        <div class="mt-4 flex justify-end">
            <a href="/repair-item/{{ x['ID'] }}"
               class="px-3 py-1 rounded-lg bg-[#6fb7ff] text-[#0b2c4d] font-semibold text-sm hover:bg-[#5aa7f0] transition">
                View
            </a>
        </div>

    </div>

</div>

{% endfor %}

</div>

</section>

</main>

{% include "components/footer.html.jinja" %}

</body>
</html>