<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/static/style.css" rel="stylesheet">
            <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body class="min-h-screen flex flex-col">

  {% include "components/navbar.html.jinja" %}

 <main class="ml-64 px-4 md:px-8 py-8">

    <!-- Page Header -->
    <section class="max-w-7xl mx-auto mb-10">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
     <h1 class="text-3xl font-extrabold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
  Products
</h1>
<p class="text-blue-500 mt-1">Browse and select your favorite items.</p>
        <a href="/cart"
           class="inline-flex items-center px-5 py-2.5 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition">
          Go to Cart →
        </a>
      </div>
    </section>

    <!-- Product Grid -->
    <section class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">

        {% for x in products %}
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 hover:shadow-lg transition overflow-hidden flex flex-col">

          <!-- Image -->
          <a href="/product/{{ x['ID'] }}"
             class="h-52 bg-gray-100 flex items-center justify-center p-4 overflow-hidden">
            <img
              src="{{ x['Image'] }}"
              alt="{{ x['Name'] }}"
              class="max-h-full object-contain transition duration-300 hover:scale-105"
            />
          </a>

          <!-- Content -->
          <div class="flex flex-col flex-1 p-5">

            <!-- Title -->
            <a href="/product/{{ x['ID'] }}">
              <h3 class="text-lg font-bold text-gray-900 hover:text-blue-600 transition">
                {{ x['Name'] }}
              </h3>
            </a>

            <!-- Spacer -->
            <div class="flex-grow"></div>

            <!-- Bottom Section -->
            <div class="mt-5 flex items-center justify-between">

              <!-- Price -->
              <span class="text-lg font-extrabold text-gray-900">
                ${{ "%.2f"|format(x['Price']) }}
              </span>

              <!-- Shop Button -->
              <a href="/product/{{ x['ID'] }}"
                 class="px-4 py-2 rounded-lg bg-blue-500 text-white font-semibold hover:bg-yellow-600 transition">
                Shop
              </a>

            </div>

          </div>
        </div>
        {% endfor %}

      </div>
    </section>

  </main>

  {% include "components/footer.html.jinja" %}

</body>
</html>