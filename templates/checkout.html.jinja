<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">
</head>

<body class="min-h-screen flex flex-col bg-[#0b2c4d] text-[#d6ecff] font-[Inter]">

{% include "components/navbar.html.jinja" %}

<main class="flex-grow">

<h1 class="text-4xl font-bold mb-8 text-white">Checkout</h1>

{% if cart|length == 0 %}
    <p class="text-gray-400 text-lg">Your cart is empty.</p>
{% else %}

{% set ns = namespace(total=0) %}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <!-- CART ITEMS -->
    <div class="lg:col-span-2 space-y-6">

        {% for x in cart %}

            {% set ns.total = ns.total + (x['price'] * x['quantity']) %}

            <div class="cart-item grid grid-cols-6 items-center bg-white rounded-2xl shadow-md p-4 gap-4"
                 data-price="{{ x['price'] }}">

                <img src="{{ x['image'] }}"
                     class="h-28 w-28 object-contain rounded-lg border">

                <div class="col-span-2 font-semibold text-gray-900 text-lg">
                    {{ x['name'] }}
                </div>

                <div class="col-span-1 flex flex-col items-center">
                    <input type="number"
                           class="quantity-input w-16 border rounded-lg px-2 py-1 text-center text-gray-900"
                           value="{{ x['quantity'] }}" min="1">

                    <form method="post" action="/cart/{{ x['product_id'] }}/remove">
                        <button class="bg-red-500 text-white px-3 py-1 mt-2 rounded">
                            Remove
                        </button>
                    </form>
                </div>

                <div class="col-span-2 text-right">
                    <div class="text-gray-900 font-semibold">
                        ${{ x['price'] }}
                    </div>

                    <div class="text-sm text-gray-500 subtotal">
                        Subtotal: ${{ x['price'] * x['quantity'] }}
                    </div>
                </div>

            </div>

        {% endfor %}

    </div>

    <!-- SUMMARY -->
    <div class="bg-white rounded-2xl shadow-lg p-6 h-fit">

        <h2 class="text-2xl font-bold text-gray-900">Order Summary</h2>

        <div class="text-gray-500 mt-2">Total</div>

        <div class="text-3xl font-bold text-green-600" id="order-total">
            ${{ ns.total }}
        </div>

        <form method="post" action="/checkout" class="mt-6 space-y-3">

            <input type="text" name="street" placeholder="Street"
                   class="w-full border rounded-lg px-3 py-2 text-gray-900" required>

            <input type="text" name="city" placeholder="City"
                   class="w-full border rounded-lg px-3 py-2 text-gray-900" required>

            <div class="grid grid-cols-2 gap-2">
                <input type="text" name="state" placeholder="State"
                       class="w-full border rounded-lg px-3 py-2 text-gray-900" required>

                <input type="text" name="zip" placeholder="ZIP"
                       class="w-full border rounded-lg px-3 py-2 text-gray-900" required>
            </div>

            <button type="submit"
                    class="w-full bg-green-500 hover:bg-green-600 text-white font-bold py-3 rounded-lg">
                Place Order
            </button>

        </form>

    </div>

</div>

{% endif %}

</main>

<script>
const inputs = document.querySelectorAll('.quantity-input');
const totalEl = document.querySelector('#order-total');

function update() {
    let total = 0;

    document.querySelectorAll('.cart-item').forEach(item => {
        const price = parseFloat(item.dataset.price);
        const qty = parseInt(item.querySelector('.quantity-input').value);
        const sub = price * qty;

        item.querySelector('.subtotal').textContent =
            `Subtotal: $${sub.toFixed(2)}`;

        total += sub;
    });

    totalEl.textContent = `$${total.toFixed(2)}`;
}

inputs.forEach(i => i.addEventListener('input', update));
</script>

{% include "components/footer.html.jinja" %}

</body>
</html>