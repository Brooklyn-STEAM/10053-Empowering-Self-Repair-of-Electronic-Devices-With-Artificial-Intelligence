<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Checkout </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">
</head>

<body class="bg-[#0b2c4d] text-white font-sans min-h-screen flex flex-col">

{% include "components/navbar.html.jinja" %}

<main class="flex-1 max-w-6xl mx-auto p-6 space-y-8">

    <div class="text-center">
        <h1 class="text-4xl font-bold">Checkout</h1>
        <p class="text-gray-300 mt-2">Review your items before placing your order</p>
    </div>

    {% if cart|length == 0 %}

        <p class="text-center text-gray-400 mt-20 text-lg">
            Your cart is empty.
        </p>

    {% else %}

    {% set ns = namespace(total=0) %}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- CART -->
        <div class="lg:col-span-2 space-y-4">

            {% for x in cart %}
            {% set ns.total = ns.total + (x['price'] * x['quantity']) %}

            <!-- IMPORTANT: data-price FIX -->
            <div class="bg-[#0e3a63] border border-[#6fb7ff] rounded-xl shadow-lg p-4 flex items-center gap-4"
                 data-price="{{ x['price'] }}">

                <div class="w-20 h-20 bg-[#0b2c4d] rounded overflow-hidden border border-[#1f4f7a]">
                    <img src="{{ x['image'] }}" class="w-full h-full object-cover">
                </div>

                <div class="flex-1">
                    <p class="font-semibold">{{ x['name'] }}</p>
                    <p class="text-sm text-gray-300">Unit: ${{ x['price'] }}</p>
                </div>

                <div class="text-center">
                    <input type="number"
                           class="quantity-input w-16 bg-[#0b2c4d] border border-[#6fb7ff] rounded px-2 py-1 text-center"
                           value="{{ x['quantity'] }}" min="1">

                    <form method="post" action="/cart/{{ x['product_id'] }}/remove">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

                        <button class="text-red-400 text-xs mt-2 hover:text-red-300">
                            Remove
                        </button>
                    </form>
                </div>

                <div class="text-right">
                    <p class="text-xs text-gray-300">Subtotal</p>
                    <p class="subtotal font-bold">
                        ${{ x['price'] * x['quantity'] }}
                    </p>
                </div>

            </div>

            {% endfor %}

        </div>

        <!-- SUMMARY -->
        <div class="bg-[#0e3a63] border border-[#6fb7ff] rounded-xl shadow-lg p-6 h-fit sticky top-6">

            <h2 class="text-xl font-bold border-b border-[#6fb7ff] pb-2 mb-4">
                Order Summary
            </h2>

            <p class="text-gray-300 text-sm">Total</p>

            <div class="text-3xl font-bold text-green-400 mb-6" id="order-total">
                ${{ ns.total }}
            </div>

            <form method="post" action="/checkout" class="space-y-3">

                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <input type="text" name="street" placeholder="Street"
                       class="w-full bg-[#0b2c4d] border border-[#6fb7ff] rounded px-3 py-2" required>

                <input type="text" name="city" placeholder="City"
                       class="w-full bg-[#0b2c4d] border border-[#6fb7ff] rounded px-3 py-2" required>

                <div class="grid grid-cols-2 gap-2">
                    <input type="text" name="state" placeholder="State"
                           class="w-full bg-[#0b2c4d] border border-[#6fb7ff] rounded px-3 py-2" required>

                    <input type="text" name="zip" placeholder="ZIP"
                           class="w-full bg-[#0b2c4d] border border-[#6fb7ff] rounded px-3 py-2" required>
                </div>

                <button type="submit"
                        class="w-full bg-[#6fb7ff] text-[#0b2c4d] font-bold py-3 rounded hover:bg-blue-400 transition">
                    Place Order
                </button>

            </form>

        </div>

    </div>

    {% endif %}

</main>

<!-- FIXED JS -->
<script>
function update() {
    let total = 0;

    document.querySelectorAll('[data-price]').forEach(card => {

        const price = parseFloat(card.dataset.price) || 0;
        const input = card.querySelector('.quantity-input');
        const qty = parseInt(input.value) || 1;

        const sub = price * qty;

        const subtotalEl = card.querySelector('.subtotal');
        subtotalEl.textContent = `$${sub.toFixed(2)}`;

        total += sub;
    });

    document.getElementById("order-total").textContent =
        `$${total.toFixed(2)}`;
}

document.querySelectorAll('.quantity-input')
    .forEach(i => i.addEventListener('input', update));

update();
</script>

{% include "components/footer.html.jinja" %}

</body>
</html>