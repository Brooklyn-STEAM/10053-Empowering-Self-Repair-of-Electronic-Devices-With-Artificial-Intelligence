<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Checkout</title>
  <link rel="icon" href="/static/products/Blueprint Logo.png" type="image/png">
</head>
<body class="bg-[#0b2c4d] text-[#d6ecff] font-mono min-h-screen flex flex-col">

{% include "components/navbar.html.jinja" %}

<main class="ml-64 px-4 md:px-8 py-8 flex-1">

  <h1 class="text-4xl font-bold mb-8 text-white">Checkout</h1>

  {% if cart|length == 0 %}
    <p class="text-gray-500 text-lg">Your cart is empty.</p>
  {% else %}

  {% set ns = namespace(total=0) %}

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <!-- LEFT COLUMN: CART ITEMS -->
    <div class="lg:col-span-2 space-y-6">

      {% for x in cart %}
        {% set ns.total = ns.total + (x['Price'] * x['Quantity']) %}

        <div class="grid grid-cols-6 items-center bg-white rounded-2xl shadow-md p-4 gap-4 hover:shadow-lg transition transform hover:scale-[1.01]">
          
          <!-- Product Image -->
          <img src="{{ x['Image'] }}" alt="{{ x['Name'] }}"
               class="h-28 w-28 object-contain rounded-lg border">

          <!-- Product Name -->
          <div class="col-span-2 font-semibold text-gray-900 text-lg">
            {{ x['Name'] }}
          </div>

          <!--  Remove -->
          <div class="col-span-1 flex flex-col items-center justify-center gap-2">
            <form method="post" action="/cart/{{ x['ProductID'] }}/remove">
              <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-sm transition">
                Remove
              </button>
            </form>
          </div>

          <!-- Price + Subtotal -->
          <div class="col-span-2 text-right">
            <div class="font-semibold text-gray-900 text-lg">${{ x['Price'] }}</div>
            <div class="text-sm text-gray-500">
              Subtotal: ${{ x['Price'] * x['Quantity'] }}
            </div>
          </div>

        </div>
      {% endfor %}

    </div>

    <!-- RIGHT COLUMN: ORDER SUMMARY + SHIPPING -->
    <div class="flex flex-col space-y-6 lg:col-span-1">

      <!-- ORDER SUMMARY -->
      <div class="bg-white rounded-2xl shadow-lg p-6">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">Order Summary</h2>
        <div class="text-gray-500 font-medium">Order Total</div>
        <div class="text-3xl font-extrabold text-green-600 mt-1" id="order-total">
          ${{ ns.total }}
        </div>
      </div>

      <!-- SHIPPING FORM -->
      <div class="bg-white rounded-2xl shadow-lg p-6 flex flex-col space-y-4">
        <h2 class="text-2xl font-bold text-gray-900">Shipping Address</h2>

        <form method="post" action="/thank_you" class="space-y-4 text-sm">

          <input type="text" name="street" placeholder="Street" required
                 class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-400 text-gray-900">

          <input type="text" name="city" placeholder="City" required
                 class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-400 text-gray-900">

          <div class="grid grid-cols-2 gap-2">
            <input type="text" name="state" placeholder="State" required
                   class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-400 text-gray-900">
            <input type="text" name="zip" placeholder="Zip" required
                   class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-400 text-gray-900">
          </div>

          <button type="submit" id="place-order-btn"
                  class="w-full bg-green-500 hover:bg-green-600 text-white font-bold py-3 rounded-lg transition transform hover:scale-105 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed">
            Place Order
          </button>
        </form>
      </div>

    </div>

  </div>

  {% endif %}

</main>

<!-- Dynamic subtotal + total update -->
<script>
const quantityInputs = document.querySelectorAll('.quantity-input');
const orderTotalEl = document.querySelector('#order-total');
const placeOrderBtn = document.querySelector('#place-order-btn');

function updateTotals() {
  let total = 0;
  document.querySelectorAll('.cart-item').forEach(item => {
    const price = parseFloat(item.dataset.price);
    const qty = parseInt(item.querySelector('.quantity-input').value);
    const subtotalEl = item.querySelector('.subtotal');
    const subtotal = price * qty;
    subtotalEl.textContent = `Subtotal: $${subtotal.toFixed(2)}`;
    total += subtotal;
  });
  orderTotalEl.textContent = `$${total.toFixed(2)}`;
  
  placeOrderBtn.disabled = total === 0;
}

quantityInputs.forEach(input => {
  input.addEventListener('input', updateTotals);
});
</script>

{% include "components/footer.html.jinja" %}
</body>
</html>