<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Repair</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">
</head>


<body class="bg-[#0b2c4d] text-[#d6ecff] min-h-screen flex flex-col text-sm lg:text-xl">
<div id="mainContent" class="transition-all duration-300" style="margin-right: 0;">

    <!-- AI CHAT -->
    {% include "components/ai_chat.html.jinja" %}

    <main class="flex-grow">

        <!-- NAVBAR -->
        {% include "components/navbar.html.jinja" %}

        <!-- HEADER -->
        <header class="bg-[#0e3a63] border-b-2 border-dashed border-[#6fb7ff]">
            <div class="max-w-6xl mx-auto py-14 px-6 text-center">
                <h1 class="text-3xl md:text-4xl mb-4 border-b-2 border-dashed border-[#6fb7ff] inline-block pb-2">
                    Welcome to the Repair Page
                </h1>
                <p class="max-w-2xl mx-auto text-base md:text-lg leading-relaxed">
                    Step-by-step guides and equipment to help you repair your device safely and correctly. All Guides are currated by iFixit and their community of repair experts.
                </p>
            </div>
        </header>

        <!-- CONTENT -->
        <section class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 px-6 py-12">

            <!-- LINKS -->
            <div class="flex flex-col gap-5">
                <a href="/phone_guides"
                   class="bg-[#0e3a63] p-5 rounded-lg border-2 border-dashed border-[#6fb7ff] text-center hover:bg-[#123f6b] transition">
                    Phone Guides
                </a>

                <a href="/browse"
                   class="bg-[#0e3a63] p-5 rounded-lg border-2 border-dashed border-[#6fb7ff] text-center hover:bg-[#123f6b] transition">
                    Repair Equipment
                </a>
            </div>

            <!-- TEXT -->
            <div class="bg-[#0e3a63] p-6 rounded-lg border-2 border-dashed border-[#6fb7ff]">
                <h2 class="text-2xl md:text-3xl mb-4 border-b-2 border-dashed border-[#6fb7ff] inline-block pb-2">
                    Repair Tips
                </h2>

                <p class="text-base md:text-lg leading-relaxed mb-4">
                    Use the links to find detailed guides and equipment for your repair. Follow these general tips for a successful repair:
                </p>

                <ul class="list-disc pl-6 space-y-2 text-base">
                    <li>Turn off the device first</li>
                    <li>Use the correct screwdriver size</li>
                    <li>Keep screws organized</li>
                    <li>Follow steps in order</li>
                </ul>
            </div>

        </section>

    </main>

    <!-- FOOTER -->
    {% include "components/footer.html.jinja" %}
</div>
</body>
</html>