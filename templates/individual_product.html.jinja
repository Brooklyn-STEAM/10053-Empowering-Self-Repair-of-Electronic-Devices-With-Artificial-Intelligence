<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{product['Name']}}</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">

    <style>
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .fade-in { animation: fadeIn 0.5s ease forwards; }
    </style>
</head>

<body class="bg-[#0b2c4d] text-[#d6ecff] font-mono min-h-screen flex flex-col text-sm lg:text-lg">

{% include "components/ai_chat.html.jinja" %}
{% include "components/navbar.html.jinja" %}

<main class="flex-grow px-4 py-8 lg:py-10">

<div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-10 items-start">

<!-- IMAGE -->
<div class="bg-gradient-to-b from-[#0e3a63] to-[#0b2c4d]
            border border-[#6fb7ff]/30 rounded-2xl p-5 sm:p-6
            shadow-[0_10px_30px_rgba(0,0,0,0.35)] fade-in group">

    <div class="relative overflow-hidden rounded-xl
                bg-[#081f38] border border-[#6fb7ff]/20
                flex items-center justify-center
                h-[320px] sm:h-[380px] lg:h-[420px]">

        <div class="absolute inset-0 bg-gradient-radial from-[#6fb7ff]/10 via-transparent to-transparent opacity-60"></div>

        <img src="{{ product['Image'] }}"
             alt="{{ product['Name'] }}"
             class="relative z-10 max-h-full max-w-full object-contain
                    transition duration-500 ease-out
                    group-hover:scale-105
                    drop-shadow-[0_10px_25px_rgba(0,0,0,0.6)]">

        <div class="absolute inset-0 opacity-0 group-hover:opacity-100
                    bg-gradient-to-tr from-transparent via-white/5 to-transparent
                    transition duration-500"></div>
    </div>
</div>

<!-- INFO -->
<div class="space-y-6 fade-in sticky top-6">

    <div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold">
            {{ product['Name'] }}
        </h1>

        <p class="text-xs text-gray-400 uppercase tracking-widest mt-2">
            Price
        </p>

        <p class="text-3xl text-[#6fb7ff] font-extrabold mt-1">
            ${{ product['Price'] }}
        </p>
    </div>

    <div class="bg-[#0e3a63] border border-[#6fb7ff]/40 p-6 rounded-xl">
        <p class="text-[#cde7ff] leading-relaxed">
            {{ product['Description'] }}
        </p>
    </div>

    <!-- ADD TO CART -->
    <form method="POST"
          id="add-to-cart-form"
          action="/cart/{{ product['ID'] }}/add_to_cart"
          class="bg-[#0e3a63] border border-[#6fb7ff]/40 p-6 rounded-xl space-y-4">

        <div>
            <label class="block text-sm mb-2 uppercase tracking-wide text-gray-300">
                Quantity
            </label>

            <input type="number" name="quantity" value="1" min="1"
                   class="w-24 bg-[#0b2c4d] border border-[#6fb7ff] text-center rounded-md p-2">
        </div>

        <button type="submit"
                class="w-full bg-[#6fb7ff] hover:bg-[#5aa7f0] text-[#0b2c4d]
                       font-bold py-3 rounded-lg transition">
            Add to Cart
        </button>
    </form>

</div>
</div>

<!-- REVIEWS -->
<div class="max-w-4xl mx-auto mt-20">

    <h2 class="text-3xl font-bold text-center border-b border-[#6fb7ff] pb-4 mb-8">
        Customer Reviews
    </h2>

    {% if current_user.is_authenticated %}
    <div class="bg-[#0e3a63] border border-[#6fb7ff]/40 p-6 rounded-xl mb-10">
        <h3 class="text-xl font-bold mb-4">Write a Review</h3>

        <form method="POST" action="/product/{{ product['ID'] }}/review">

            <input type="number" name="rating" min="1" max="5" value="5"
                   class="w-full mb-4 p-2 rounded bg-[#0b2c4d] border border-[#6fb7ff]">

            <textarea name="comment" rows="4"
                      class="w-full mb-4 p-2 rounded bg-[#0b2c4d] border border-[#6fb7ff]"></textarea>

            <button class="bg-[#6fb7ff] text-[#0b2c4d] px-4 py-2 rounded font-bold">
                Submit Review
            </button>
        </form>
    </div>
    {% else %}
        <p class="text-center text-gray-400 mb-10">
            <a href="/login" class="text-[#6fb7ff] font-bold hover:underline">
                Log in
            </a>
            to write a review.
        </p>
    {% endif %}

    <!-- REVIEW LIST -->
    <div class="space-y-6">

        {% if reviews %}
            {% for x in reviews %}
            <div class="bg-[#0e3a63] border border-[#6fb7ff]/40
                        hover:border-[#6fb7ff] transition
                        p-6 rounded-xl shadow-md hover:shadow-lg">

                <div class="flex justify-between mb-2">
                    <p class="font-bold">{{ x["Name"] }}</p>
                    <p class="text-xs text-gray-400">
                        {{ x["Timestamp"].strftime('%m/%d/%Y') }}
                    </p>
                </div>

                <div class="mb-2">
                    {% for i in range(1, 6) %}
                        <span class="{% if i <= x['Ratings'] %}text-yellow-400{% else %}text-gray-500{% endif %}">
                            ★
                        </span>
                    {% endfor %}
                </div>

                <p class="text-gray-200">
                    {{ x["Comment"] }}
                </p>

            </div>
            {% endfor %}
        {% else %}
            <p class="text-center text-gray-400">
                No reviews yet. Be the first to review!
            </p>
        {% endif %}

    </div>
</div>

</main>

<!-- STICKY ADD TO CART -->
<div id="sticky-add-to-cart"
     class="fixed bottom-0 left-0 right-0 bg-[#0e3a63]
            border-t border-[#6fb7ff] p-4 z-50 shadow-lg hidden">

    <button type="submit"
            form="add-to-cart-form"
            class="w-full bg-[#6fb7ff] text-[#0b2c4d] font-bold py-3 rounded-lg">
        Add to Cart
    </button>
</div>

<!-- JS -->
<script>
document.addEventListener("scroll", function () {
    const sticky = document.getElementById("sticky-add-to-cart");
    const form = document.getElementById("add-to-cart-form");

    if (!sticky || !form) return;

    const rect = form.getBoundingClientRect();

    if (rect.bottom < 0) {
        sticky.classList.remove("hidden");
    } else {
        sticky.classList.add("hidden");
    }
});
</script>

{% include "components/footer.html.jinja" %}

</body>
</html>