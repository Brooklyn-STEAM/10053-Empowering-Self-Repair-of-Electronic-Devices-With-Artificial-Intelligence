<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>

    <link href="/static/style.css" rel="stylesheet">
    <link rel="icon" href="/static/products/Blueprint Logo.png" type="image">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen flex flex-col bg-[#0b2c4d] text-[#d6ecff]">

<div id="mainContent" class="flex-grow flex flex-col">

{% include "components/navbar.html.jinja" %}

<main class="flex-grow flex items-center justify-center px-6 py-12">

    <div class="w-full max-w-md bg-[#0e3a63]
                border border-[#6fb7ff]/40
                rounded-2xl p-8 shadow-lg">

        <h1 class="text-3xl font-bold text-center mb-6">
            Reset Password
        </h1>

        <!-- FLASHES -->
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                <div class="space-y-3 mb-4">
                    {% for category, message in messages %}
                        <div class="px-4 py-3 rounded-lg font-semibold
                            {% if category == 'error' %}
                                bg-red-500 text-white
                            {% else %}
                                bg-green-500 text-white
                            {% endif %}">
                            {{ message }}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endwith %}

        <form method="POST" class="space-y-5">

            <input type="hidden"
                   name="csrf_token"
                   value="{{ csrf_token() }}">

            <div>
                <label class="block text-sm mb-2 text-gray-300">
                    New Password
                </label>

                <input
                    type="password"
                    name="password"
                    required
                    minlength="8"
                    class="w-full px-4 py-3 rounded-lg
                           bg-[#0b2c4d]
                           border border-[#6fb7ff]
                           text-white
                           focus:outline-none
                           focus:ring-2
                           focus:ring-[#6fb7ff]"
                >
            </div>

            <div>
                <label class="block text-sm mb-2 text-gray-300">
                    Confirm Password
                </label>

                <input
                    type="password"
                    name="confirm_password"
                    required
                    minlength="8"
                    class="w-full px-4 py-3 rounded-lg
                           bg-[#0b2c4d]
                           border border-[#6fb7ff]
                           text-white
                           focus:outline-none
                           focus:ring-2
                           focus:ring-[#6fb7ff]"
                >
            </div>

            <button
                type="submit"
                class="w-full bg-[#6fb7ff]
                       hover:bg-[#5aa7f0]
                       text-[#0b2c4d]
                       font-bold
                       py-3 rounded-lg transition">

                Reset Password

            </button>

        </form>

    </div>

</main>

{% include "components/footer.html.jinja" %}

</div>

</body>
</html>