<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Repair Showcase</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen flex flex-col bg-[#0b2c4d] text-[#d6ecff] font-[Inter]">

<div id="mainContent"
     class="flex flex-col flex-grow transition-all duration-300 "
     style="margin-right: 0;">

    <!-- NAVBAR -->
    {% include "components/navbar.html.jinja" %}

    <main class="flex-grow">


        <div class="max-w-5xl mx-auto">

            <h1 class="text-4xl font-bold mt-3">
                🔧 {{ repair['guide_name'] }}
            </h1>

            <p class="text-blue-200 mb-10">
                Submitted by {{ repair['username'] }}
            </p>

            <!-- IMAGES -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">

                <div>
                    <h2 class="text-2xl font-bold mb-3">
                        Before
                    </h2>

                    <img src="{{ url_for('static', filename=repair['before_image']) }}"
                        class="rounded w-full h-100 object-contain shadow-md" alt="Before repair">
                </div>

                <div>
                    <h2 class="text-2xl font-bold mb-3">
                        After
                    </h2>

                    <img src="{{ url_for('static', filename=repair['after_image']) }}"
                        class="rounded w-full h-100 object-contain shadow-md" alt="After repair">
                </div>

            </div>

            <!-- NOTES -->
            <div class="space-y-6">

                {% if repair['easy_parts'] %}

                <div class="bg-[#163d63] p-6 rounded-2xl">

                    <h2 class="text-2xl font-bold mb-3">
                        ✅ Easy Parts
                    </h2>

                    <p>{{ repair['easy_parts'] }}</p>

                </div>

                {% endif %}

                {% if repair['difficult_parts'] %}

                <div class="bg-[#163d63] p-6 rounded-2xl">

                    <h2 class="text-2xl font-bold mb-3">
                        ⚠️ Difficult Parts
                    </h2>

                    <p>{{ repair['difficult_parts'] }}</p>

                </div>

                {% endif %}

            </div>

            <div class="mt-10">

                <a href="/user_repairs/{{ repair['user_id'] }}"
                class="bg-blue-600 hover:bg-blue-700 px-6 py-3 rounded-xl font-bold">

                    ← Back

                </a>

            </div>

        </div>
</main>

{% include "components/footer.html.jinja" %}
</div>

</body>
</html>