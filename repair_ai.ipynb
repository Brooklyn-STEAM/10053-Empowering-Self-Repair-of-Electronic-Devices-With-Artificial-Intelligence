    "from datasets import load_dataset\n",
    "\n",
    "# Load dataset\n",
    "dataset = load_dataset(\"ankithreddy/repairdataset-mini\")\n",
    "\n",
    "# Collect useful repair steps\n",
    "repair_texts = []\n",
    "\n",
    "for item in dataset['train']:\n",
    "    if item['type'] == 'step_instruction':\n",
    "        repair_texts.append(item['text'])\n",
    "\n",
    "# Save to file\n",
    "with open(\"repair_knowledge.txt\", \"w\") as f:\n",
    "    for text in repair_texts:\n",
    "        f.write(text + \"\\n\\n\")\n",
    "\n",
    "print(\"✅ repair_knowledge.txt created!\")"
   ]
  }
